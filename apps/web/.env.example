# Supabase (public, safe for the browser; RLS governs access)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Anthropic, for the classification route (server only, never NEXT_PUBLIC_)
ANTHROPIC_API_KEY=sk-ant-...

# Supabase service role (server only, never NEXT_PUBLIC_). Bypasses RLS
# entirely. Used for exactly one thing today: src/lib/supabase/service.ts,
# the pipeline write that attaches a classification to a comment
# (supabase/CLAUDE.md, "Pipeline writes use the service role from server
# code only"). The comment write itself does not use this key; it goes
# through the session-scoped client under RLS. Canonical name per
# docs/handoffs/dialecta-coherence-audit.md's correction of the recovered
# API's SUPABASE_SERVICE_KEY; do not introduce the old name alongside this one.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Site origin (public, safe for the browser). Builds the absolute URLs in
# sitemap.xml, robots.txt and article Open Graph metadata. Falls back to
# https://dialecta.org (src/lib/site.ts) if unset.
NEXT_PUBLIC_SITE_URL=https://dialecta.org

# Plausible Analytics (public, safe for the browser). No analytics script
# loads until NEXT_PUBLIC_PLAUSIBLE_DOMAIN is set (src/lib/analytics.ts).
# See CLAUDE.md, "Analytics," for what has to happen before this has a
# real value: it is not a fill-in-and-go var.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=dialecta.org
# Self-hosting instead of Plausible Cloud: point this at that instance's
# own script and leave the domain line above as the site's registered name.
# NEXT_PUBLIC_PLAUSIBLE_SCRIPT_SRC=https://plausible.example.com/js/script.js
