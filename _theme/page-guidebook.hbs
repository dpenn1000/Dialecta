{{!< default}}

<style>
/* ─────────────────────────────────────────────────────────────────────
   GUIDEBOOK PAGE — refreshed 2026-04-29 to match the About-page treatment.
   Brass + walnut accents, paper-grain, fluid responsive type.
   Content-specific cards (tier-card, claim-card, map-card, stage,
   prompt-box, submit-box, callout) keep their existing color-coded
   styling untouched below.
   ─────────────────────────────────────────────────────────────────── */
.page {
  --paper-grain: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='g'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23g)' opacity='0.045'/%3E%3C/svg%3E");
  --walnut:   #4a2810;
  --cherry:   #6e3917;
  --burnt:    #8a4a18;
  --mahogany: #5e2a14;

  /* Hero brass — high-key metallic for the dark stone backdrop. */
  --hero-brass: linear-gradient(95deg,
    var(--brass-warm)   0%,
    var(--brass-bright) 22%,
    var(--brass-pale)   50%,
    var(--brass-bright) 78%,
    var(--brass-warm)   100%);
  --hero-brass-shadow:
    drop-shadow(0 1px 1px rgba(0, 0, 0, 0.45))
    drop-shadow(0 2px 0 rgba(28, 24, 20, 0.30));

  /* Card brass — for text on cream paper card surfaces. Swaps the
     canonical --brass-pale peak (which disappears on cream) for
     --brass-bright (visible saturated yellow-orange peak). */
  --card-brass: linear-gradient(95deg,
    var(--brass-deep)   0%,
    var(--brass-mid)    20%,
    var(--brass-warm)   38%,
    var(--brass-bright) 50%,
    var(--brass-warm)   62%,
    var(--brass-mid)    80%,
    var(--brass-deep)   100%);

  max-width: 880px;
  margin: 0 auto;
  padding: 0 clamp(20px, 4vw, 32px) clamp(60px, 8vw, 120px);
  position: relative;
  z-index: 1;
}

/* ── HERO ─────────────────────────────────────────────────────────── */
.hero {
  margin-bottom: clamp(40px, 6vw, 72px);
  padding-bottom: clamp(28px, 4vw, 48px);
  border-bottom: none;
  position: relative;
}
.hero::after {
  content: "✦   ✦   ✦";
  display: block;
  font-family: var(--font-display);
  font-size: clamp(1rem, 1vw + 0.7rem, 1.4rem);
  color: var(--gold);
  letter-spacing: 0.4em;
  margin-top: clamp(28px, 3vw, 40px);
  opacity: 0.55;
}
.hero-eyebrow {
  font-family: var(--font-mono); font-size: 11px; font-weight: 500;
  letter-spacing: 0.28em; text-transform: uppercase;
  margin-bottom: 18px;
  /* High-key brass for legibility on the dark stone backdrop. */
  background: var(--hero-brass);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
          background-clip: text; color: transparent;
  filter: var(--hero-brass-shadow);
  display: inline-block;
}
.hero-title {
  font-family: var(--font-display);
  font-size: clamp(2.2rem, 6vw + 0.5rem, 4.4rem);
  font-weight: 500;
  line-height: 1.05;
  color: var(--text-primary);
  margin-bottom: 24px;
  letter-spacing: -0.01em;
  max-width: 14ch;
}
.hero-title em {
  font-style: italic;
  font-weight: 400;
  /* High-key brass + harder shadow so the metallic shimmer reads on
     the dark stone gradient. */
  background: var(--hero-brass);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
          background-clip: text; color: transparent;
  filter: var(--hero-brass-shadow);
}
.hero-lede {
  font-family: var(--font-reading);
  font-size: clamp(1rem, 0.5vw + 0.92rem, 1.25rem);
  font-style: italic;
  line-height: 1.7;
  color: var(--text-lede);
  max-width: 56ch;
  font-weight: 400;
  margin: 0;
}

/* ── SECTION CARDS (paper-grained leaves with wood spine) ─────────── */
.section {
  background-color: var(--paper);
  background-image: var(--paper-grain);
  border: 1px solid var(--border-light);
  border-radius: 8px;
  /* ~40% padding cut. Top equals sides; bottom uniform. */
  padding: clamp(14px, 2.4vw, 26px);
  margin-bottom: clamp(18px, 3vw, 32px);
  scroll-margin-top: 100px;
  box-shadow:
    0 1px 3px rgba(74, 40, 16, 0.04),
    0 4px 18px rgba(74, 40, 16, 0.06);
  position: relative;
}
.section::before {
  content: "";
  position: absolute;
  top: clamp(8px, 1.5vw, 14px);
  bottom: clamp(8px, 1.5vw, 14px);
  left: 0;
  width: 3px;
  background: linear-gradient(to bottom,
    transparent 0%,
    var(--burnt) 16%,
    var(--cherry) 50%,
    var(--burnt) 84%,
    transparent 100%);
  border-radius: 0 2px 2px 0;
}
.section-label {
  font-family: var(--font-mono); font-size: 10px; font-weight: 500;
  letter-spacing: 0.22em; text-transform: uppercase;
  margin-bottom: 8px;
  display: inline-block;
  /* --card-brass: visible peak on cream paper. */
  background: var(--card-brass);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
          background-clip: text; color: transparent;
  filter: var(--brass-shadow);
}
.section-title {
  font-family: var(--font-display);
  font-size: clamp(1.6rem, 3vw + 0.6rem, 2.4rem);
  font-weight: 500;
  line-height: 1.12;
  color: var(--text-primary);
  margin-bottom: 10px;
  letter-spacing: -0.005em;
}
.section-title em {
  font-style: italic;
  font-weight: 400;
  /* Highlighted titlecase words: card-brass for visible peak. */
  background: var(--card-brass);
  -webkit-background-clip: text; -webkit-text-fill-color: transparent;
          background-clip: text; color: transparent;
  filter: var(--brass-shadow);
}
.section-desc {
  font-family: var(--font-reading);
  font-size: clamp(0.95rem, 0.4vw + 0.85rem, 1.05rem);
  color: var(--text-secondary);
  line-height: 1.75;
  font-weight: 400;
  max-width: 720px;
  margin-bottom: 28px;
  font-style: italic;
}
/* Divider not needed inside the card — the card already separates. */
.section-divider { display: none; }
.prose { font-family: var(--font-reading); font-size: 0.975rem; line-height: 1.85; color: var(--text-prose); max-width: 680px; }
.prose strong { color: var(--text-primary); font-weight: 500; }
.mt-lg { margin-top: 16px; }

.rules-list { list-style: none; display: flex; flex-direction: column; gap: 10px; max-width: 680px; margin-top: 20px; }
.rules-list li { display: flex; gap: 12px; align-items: flex-start; font-family: var(--font-reading); font-size: 0.95rem; line-height: 1.7; color: var(--text-prose); }
.rule-bullet { width: 6px; height: 6px; border-radius: 50%; background: var(--gold); flex-shrink: 0; margin-top: 9px; }

/* Tier grid — two columns on wide viewports, single column on narrow.
   Single column made the page feel like an endless scroll; two columns
   give the seven tiers a more navigable shape. */
.tier-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18px;
  margin-top: 8px;
}
@media (max-width: 720px) {
  .tier-grid { grid-template-columns: 1fr; gap: 14px; }
}

.tier-card {
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow:
    0 4px 18px rgba(28, 24, 20, 0.10),
    0 1px 3px rgba(28, 24, 20, 0.08),
    0 0 0 0.5px rgba(28, 24, 20, 0.04);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  position: relative;
}
.tier-card:hover {
  transform: translateY(-2px);
  box-shadow:
    0 8px 28px rgba(28, 24, 20, 0.14),
    0 2px 6px rgba(28, 24, 20, 0.10),
    0 0 0 0.5px rgba(28, 24, 20, 0.04);
}

.tier-card-header {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 18px 22px 16px;
  border-bottom: 1px solid rgba(0,0,0,0.08);
}
/* The icon badge is now substantial — 56px circle with depth, the icon
   rendered larger and in the tier's accent color rather than text color. */
.tier-icon-wrap {
  width: 56px; height: 56px;
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0;
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.4),
    inset 0 -1px 0 rgba(0,0,0,0.18),
    0 1px 3px rgba(0,0,0,0.18);
}
.tier-icon-wrap svg {
  width: 28px; height: 28px;
}

.tier-name { font-family: var(--font-display); font-size: 1.5rem; font-weight: 600; line-height: 1; letter-spacing: -0.005em; }
.tier-zone { font-family: var(--font-mono); font-size: 0.68rem; font-weight: 500; letter-spacing: 0.16em; text-transform: uppercase; margin-top: 4px; opacity: 0.75; }

.tier-card-body { padding: 16px 22px 18px; }
.tier-desc { font-family: var(--font-reading); font-size: 0.92rem; line-height: 1.7; margin-bottom: 12px; font-weight: 300; }
.tier-example {
  font-family: var(--font-reading);
  font-size: 0.85rem; line-height: 1.6;
  padding: 11px 15px;
  border-radius: var(--radius-sm);
  background: rgba(0,0,0,0.05);
  border-left: 3px solid rgba(0,0,0,0.18);
  font-style: italic;
}
.tier-example-label {
  font-family: var(--font-mono); font-size: 0.65rem;
  font-weight: 500; letter-spacing: 0.18em;
  text-transform: uppercase;
  margin-bottom: 5px; opacity: 0.7;
}

/* Per-tier color treatments. The icon badge gets a coin-like gradient
   matching the tier's identity, with !important to override the legacy
   inline styles still in the HTML markup. The card backgrounds use the
   tier-specific gradient tokens defined elsewhere. */
.tc-forum  { background: linear-gradient(180deg, var(--tier-forum-top),  var(--tier-forum-bot)); }
.tc-spark  { background: linear-gradient(180deg, var(--tier-spark-top),  var(--tier-spark-bot)); }
.tc-echo   { background: linear-gradient(180deg, var(--tier-echo-top),   var(--tier-echo-bot)); }
.tc-fog    { background: linear-gradient(180deg, var(--tier-fog-top),    var(--tier-fog-bot)); }
.tc-heat   { background: linear-gradient(180deg, var(--tier-heat-top),   var(--tier-heat-bot)); }
.tc-stance { background: linear-gradient(180deg, var(--tier-stance-top), var(--tier-stance-bot)); }
.tc-breach { background: linear-gradient(180deg, var(--tier-breach-top), var(--tier-breach-bot)); }

.tc-forum  .tier-name, .tc-forum  .tier-zone, .tc-forum  .tier-desc, .tc-forum  .tier-example, .tc-forum  .tier-example-label { color: var(--tier-forum-text); }
.tc-spark  .tier-name, .tc-spark  .tier-zone, .tc-spark  .tier-desc, .tc-spark  .tier-example, .tc-spark  .tier-example-label { color: var(--tier-spark-text); }
.tc-echo   .tier-name, .tc-echo   .tier-zone, .tc-echo   .tier-desc, .tc-echo   .tier-example, .tc-echo   .tier-example-label { color: var(--tier-echo-text); }
.tc-fog    .tier-name, .tc-fog    .tier-zone, .tc-fog    .tier-desc, .tc-fog    .tier-example, .tc-fog    .tier-example-label { color: var(--tier-fog-text); }
.tc-heat   .tier-name, .tc-heat   .tier-zone, .tc-heat   .tier-desc, .tc-heat   .tier-example, .tc-heat   .tier-example-label { color: var(--tier-heat-text); }
.tc-stance .tier-name, .tc-stance .tier-zone, .tc-stance .tier-desc, .tc-stance .tier-example, .tc-stance .tier-example-label { color: var(--tier-stance-text); }
.tc-breach .tier-name, .tc-breach .tier-zone, .tc-breach .tier-desc, .tc-breach .tier-example, .tc-breach .tier-example-label { color: var(--tier-breach-text); }

.tc-forum .tier-icon-wrap {
  background: linear-gradient(135deg, #F8E8A8 0%, #E8C45C 50%, #B8862E 100%) !important;
  border: 1px solid rgba(106, 84, 16, 0.45) !important;
}
.tc-spark .tier-icon-wrap {
  background: linear-gradient(135deg, #F4D098 0%, #D4862C 60%, #8C5810 100%) !important;
  border: 1px solid rgba(106, 60, 8, 0.5) !important;
}
.tc-echo .tier-icon-wrap {
  background: linear-gradient(135deg, #DCE8C4 0%, #A8BC88 55%, #6A8048 100%) !important;
  border: 1px solid rgba(56, 68, 12, 0.45) !important;
}
.tc-fog .tier-icon-wrap {
  background: linear-gradient(135deg, #CCD2DC 0%, #8C9AAC 55%, #5A6478 100%) !important;
  border: 1px solid rgba(44, 56, 72, 0.45) !important;
}
.tc-heat .tier-icon-wrap {
  background: linear-gradient(135deg, #F4B488 0%, #D86E2C 50%, #7C2C08 100%) !important;
  border: 1px solid rgba(56, 16, 4, 0.5) !important;
}
.tc-stance .tier-icon-wrap {
  background: linear-gradient(135deg, #C46858 0%, #8A3428 55%, #401818 100%) !important;
  border: 1px solid rgba(40, 16, 16, 0.5) !important;
}
.tc-breach .tier-icon-wrap {
  background: linear-gradient(135deg, #8A2828 0%, #4A1010 55%, #200404 100%) !important;
  border: 1px solid rgba(20, 4, 4, 0.6) !important;
}

.stage-list { display: flex; flex-direction: column; gap: 20px; margin-top: 8px; max-width: 680px; }
.stage { background: var(--bg-white); border: 1px solid var(--border-light); border-radius: var(--radius-md); padding: 20px 22px; box-shadow: var(--shadow-sm); }
.stage-header { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; }
.stage-number { width: 28px; height: 28px; border-radius: 50%; background: linear-gradient(135deg, var(--gold-b), var(--gold)); color: #fff; font-family: var(--font-mono); font-size: 0.75rem; font-weight: 500; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.stage-name { font-family: var(--font-display); font-size: 1.1rem; font-weight: 600; color: var(--text-primary); }
.stage-desc { font-family: var(--font-reading); font-size: 0.9rem; line-height: 1.75; color: var(--text-prose); }
.stage-note { font-family: var(--font-reading); font-size: 0.88rem; line-height: 1.7; color: var(--text-secondary); margin-top: 10px; font-style: italic; }

.prompt-box { background: var(--bg-dark); border-radius: var(--radius-md); padding: 22px 24px; margin-top: 20px; max-width: 680px; overflow-x: auto; }
.prompt-label { font-family: var(--font-mono); font-size: 0.7rem; font-weight: 500; letter-spacing: 0.15em; text-transform: uppercase; color: var(--text-on-dark-secondary); margin-bottom: 12px; }
.prompt-box pre { font-family: var(--font-mono); font-size: 0.78rem; line-height: 1.7; color: var(--text-on-dark); white-space: pre-wrap; word-break: break-word; }

.callout { max-width: 680px; padding: 16px 20px; background: var(--bg-white); border-left: 3px solid var(--gold); border-radius: 0 var(--radius-sm) var(--radius-sm) 0; box-shadow: var(--shadow-sm); margin-top: 22px; }

.claim-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 8px; }
.claim-card { background: var(--bg-white); border: 1px solid var(--border-light); border-radius: var(--radius-md); padding: 18px 20px; box-shadow: var(--shadow-sm); }
.claim-level { font-family: var(--font-mono); font-size: 0.7rem; font-weight: 500; letter-spacing: 0.15em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 6px; }
.claim-name { font-family: var(--font-display); font-size: 1.1rem; font-weight: 600; color: var(--text-primary); margin-bottom: 8px; }
.claim-desc { font-family: var(--font-reading); font-size: 0.85rem; line-height: 1.65; color: var(--text-prose); margin-bottom: 10px; }
.claim-eg { font-family: var(--font-reading); font-size: 0.8rem; line-height: 1.6; color: var(--text-secondary); font-style: italic; padding: 8px 10px; background: var(--bg-secondary); border-radius: var(--radius-sm); }

.map-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-top: 8px; }
.map-card { background: var(--bg-white); border: 1px solid var(--border-light); border-radius: var(--radius-md); padding: 20px 22px; box-shadow: var(--shadow-sm); }
.map-badge { display: inline-flex; align-items: center; gap: 6px; background: var(--gold-pale); border: 1px solid rgba(212,168,74,0.35); border-radius: 20px; padding: 3px 10px; margin-bottom: 10px; font-family: var(--font-mono); font-size: 0.68rem; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; color: var(--gold-muted); }
.map-title { font-family: var(--font-display); font-size: 1.15rem; font-weight: 600; color: var(--text-primary); margin-bottom: 8px; }
.map-desc { font-family: var(--font-reading); font-size: 0.875rem; line-height: 1.7; color: var(--text-prose); margin-bottom: 12px; }
.map-example { font-family: var(--font-mono); font-size: 0.75rem; line-height: 1.6; color: var(--text-secondary); padding: 10px 12px; background: var(--bg-secondary); border-radius: var(--radius-sm); }

.submit-box { background: var(--bg-white); border: 1px solid var(--border-light); border-radius: var(--radius-md); padding: 28px 30px; box-shadow: var(--shadow-md); max-width: 680px; margin-top: 8px; }
.submit-title { font-family: var(--font-display); font-size: 1.3rem; font-weight: 600; color: var(--text-primary); margin-bottom: 10px; }
.submit-desc { font-family: var(--font-reading); font-size: 0.9rem; line-height: 1.75; color: var(--text-prose); margin-bottom: 18px; }
.submit-field { margin-bottom: 14px; }
.submit-field label { display: block; font-family: var(--font-mono); font-size: 0.72rem; font-weight: 500; letter-spacing: 0.12em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 5px; }
.submit-field input, .submit-field textarea { width: 100%; padding: 9px 12px; font-family: var(--font-reading); font-size: 0.9rem; color: var(--text-primary); background: var(--bg-secondary); border: 1px solid var(--border-medium); border-radius: var(--radius-sm); outline: none; transition: border-color 0.15s; }
.submit-field input:focus, .submit-field textarea:focus { border-color: var(--gold); }
.submit-field textarea { min-height: 80px; resize: vertical; }
.submit-btn { display: inline-flex; align-items: center; gap: 8px; background: linear-gradient(135deg, var(--gold-b), var(--gold)); color: #fff; border: none; cursor: pointer; padding: 10px 22px; border-radius: var(--radius-sm); font-family: var(--font-body); font-size: 0.85rem; font-weight: 500; letter-spacing: 0.02em; transition: opacity 0.15s; }
.submit-btn:hover { opacity: 0.88; }

@media (max-width: 720px) {
  .claim-grid, .map-grid { grid-template-columns: 1fr; }
  .nav-sub .nav-sub-links { display: none; }
  .hero-title { max-width: none; }
  .hero-title br,
  .section-title br { display: none; }
  /* Tighten card-internal cards on mobile so they don't feel claustrophobic
     inside the new section card wrapper. */
