{{!< default}}

<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --bg-primary: #f7f2e8;
    --bg-secondary: #efe8da;
    --bg-tertiary: #e8dfce;
    --bg-white: #fffdf8;
    --bg-dark: #1c1814;
    --bg-dark-elevated: #28231a;

    --text-primary: #1c1814;
    --text-body: #3a342c;
    --text-secondary: #5a5248;
    --text-tertiary: #7a7068;
    --text-muted: #9a8e80;
    --text-on-dark: #f0ebe0;

    --gold: #d4a84a;
    --gold-bright: #e8a830;
    --gold-muted: #a07828;
    --gold-pale: #f5e8d0;
    --amber: #b8732a;
    --terra: #8c4a2f;

    /* Refresh-2026-04-29: align stewards with About + Guidebook visual
       language. Wood-tone accents, paper-grain on cards, brass shimmer
       gradients tuned for dark vs cream contexts. */
    --paper: #fbf6ea;
    --walnut:   #4a2810;
    --cherry:   #6e3917;
    --burnt:    #8a4a18;
    --paper-grain: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='g'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23g)' opacity='0.045'/%3E%3C/svg%3E");
    /* Hero brass (dark backdrop): high-key, all stops readable on stone */
    --hero-brass: linear-gradient(95deg,
      #d4a84a 0%, #ecb438 22%, #f5dfa0 50%, #ecb438 78%, #d4a84a 100%);
    --hero-brass-shadow:
      drop-shadow(0 1px 1px rgba(0, 0, 0, 0.45))
      drop-shadow(0 2px 0 rgba(28, 24, 20, 0.30));
    /* Card brass (cream backdrop): visible peak at brass-bright */
    --card-brass: linear-gradient(95deg,
      #7a4a10 0%, #b8862e 20%, #d4a84a 38%, #ecb438 50%, #d4a84a 62%, #b8862e 80%, #7a4a10 100%);
    --card-brass-shadow: drop-shadow(0 2px 0 rgba(28, 24, 20, 0.20));

    --border-light: #e8e0d0;
    --border-medium: #d8ceb8;
    --border-dark: #c8bca4;
    --border-rule: #b8732a;

    --shadow-sm: 0 1px 3px rgba(28,24,20,0.04);
    --shadow-md: 0 2px 8px rgba(28,24,20,0.06), 0 0 0 1px rgba(28,24,20,0.02);
    --shadow-lg: 0 4px 20px rgba(28,24,20,0.08), 0 0 0 1px rgba(28,24,20,0.02);

    --font-display: 'Cormorant Garamond', serif;
    --font-body: 'DM Sans', sans-serif;
    --font-reading: 'Source Serif 4', Georgia, serif;
    --font-mono: 'DM Mono', monospace;

    --radius-sm: 4px; --radius-md: 8px; --radius-lg: 12px;
  }

  html { scroll-behavior: smooth; }
  body {
    font-family: var(--font-body);
    background: linear-gradient(135deg, #a8a398 0px, #8c8780 175px, #f7f2e8 775px, #f7f2e8 100%);
    color: var(--text-body);
    -webkit-font-smoothing: antialiased;
    min-height: 100vh;
  }

  /* Paper grain overlay (canonical) */
  body::before {
    content: ''; position: fixed; inset: 0; pointer-events: none; z-index: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.6'/%3E%3C/svg%3E");
    opacity: 0.035;
  }

  /* ── Primary nav: logo bar (v1.2 two-bar system) ── */
  .spec-nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 101;
    background: linear-gradient(135deg, #f7f2e8 0%, #1c1814 65%, #1c1814 100%);
    border-bottom: 1px solid rgba(184,115,42,0.22);
    display: flex; align-items: center; height: 52px;
  }
  .spec-nav .nav-inner { width: 100%; max-width: 1060px; margin: 0 auto; padding: 0 32px 0 20px; display: flex; align-items: center; }
  .spec-nav .logo-img { height: 40px; width: auto; mix-blend-mode: multiply; display: block; }

  /* ── Sub-nav: section links ── */
  .spec-sub-nav {
    position: fixed; top: 52px; left: 0; right: 0; z-index: 100; height: 34px;
    background: linear-gradient(to bottom, #eceae4 0%, #d8d4cc 48%, #eceae4 100%);
    display: flex; align-items: center;
  }
  .spec-sub-nav::before, .spec-sub-nav::after {
    content: ''; position: absolute; left: 0; right: 0; height: 1px;
    background: linear-gradient(to right, transparent 0%, rgba(255,255,255,0.92) 8%, rgba(255,255,255,0.96) 50%, rgba(255,255,255,0.92) 92%, transparent 100%);
  }
  .spec-sub-nav::before { top: 0; } .spec-sub-nav::after { bottom: 0; }
  .spec-sub-nav .nav-inner-sub { width: 100%; max-width: 1060px; margin: 0 auto; padding: 0 32px 0 20px; display: flex; align-items: center; position: relative; z-index: 1; height: 34px; }
  .spec-sub-nav .nav-links { display: flex; align-items: center; height: 100%; }
  .spec-sub-nav .nav-links a { font-family: var(--font-body); font-size: 0.82rem; font-weight: 400; letter-spacing: 0.01em; color: #3a342c; text-decoration: none; padding: 0 13px; height: 100%; display: flex; align-items: center; border-right: 1px solid rgba(180,175,165,0.28); transition: background 0.15s, color 0.15s; }
  .spec-sub-nav .nav-links a:first-child { padding-left: 2px; }
  .spec-sub-nav .nav-links a:last-child { border-right: none; }
  .spec-sub-nav .nav-links a:hover { background: rgba(255,255,255,0.35); color: #1c1814; }

  /* ── Page container ── */
  /* Top pad was 110px (clearance for an old fixed nav this page no
     longer renders). Cut to fluid clamp matching the rest of the
     refresh. */
  .page {
    max-width: 1060px;
    margin: 0 auto;
    padding: 0 clamp(16px, 3vw, 32px) clamp(40px, 5vw, 80px);
    position: relative; z-index: 1;
  }
  @media (max-width: 768px) {
    .spec-sub-nav .nav-links { display: none; }
  }

  /* ── Masthead ── */
  .masthead {
    text-align: center;
    /* Refresh-2026-04-29 (second pass): the first cut was still too
       generous. .site-main already reserves 92px of clearance for the
       fixed nav, so the masthead doesn't need its own breathing room
       above. Cut to a hairline so the editorial sequence (eyebrow →
       prefix → logo → pair) sits right under the nav and reads as a
       single block with the opening prose. */
    padding: 4px clamp(16px, 3vw, 24px) 8px;
    margin-bottom: clamp(20px, 3vw, 28px);
    position: relative;
  }
  .masthead-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    /* 2026-05-01 — tightened gap to prefix: 18 → 10. */
    margin-bottom: 10px;
    /* Hero-brass: legible metallic against the dark stone backdrop. */
    background: var(--hero-brass);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    background-clip: text;
    filter: var(--hero-brass-shadow);
    display: inline-block;
    font-weight: 500;
  }
  .masthead-prefix {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.45rem, 2.8vw, 2rem);
    color: var(--text-secondary);
    line-height: 1;
    /* 2026-05-01 — tightened: 12 → 6. */
    margin-bottom: 6px;
    letter-spacing: 0.005em;
  }
  .masthead-logo {
    display: block;
    /* 2026-05-01 — gap below logo: 14 → 8; size dropped a tier (108 → 84)
       so the editorial sequence reads as one tight unit. */
    margin: 0 auto 8px;
    height: clamp(56px, 7.5vw, 84px);
    width: auto;
  }
  .masthead-pair {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }
  .masthead-pair-line {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.55rem, 3vw, 2.15rem);
    line-height: 1.18;
    /* 2026-04-29: switched to the canonical hero-brass gradient + shadow
       used by .masthead-eyebrow above. The previous filter chain
       included drop-shadow(0 0 1px ...), which puts a 1-pixel blurred
       halo around every glyph and reads as fuzzy text on these large
       gradient-filled italics. The hero-brass-shadow chain
       (drop-shadow(0 1px 1px ...) + drop-shadow(0 2px 0 ...)) gives a
       crisp 2-pixel shadow with no blur on the second drop, so the
       letters render sharp while still lifting off the stone backdrop. */
    background: var(--hero-brass);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: var(--hero-brass-shadow);
    letter-spacing: 0.005em;
  }

  /* ── Opening prose ──
        2026-05-01: now lives inside .masthead so the eyebrow → prefix →
        logo → pair → prose stack reads as a single header unit. The
        old standalone trust+cadence section above the orders was
        retired; this prose carries the editorial frame instead. */
  .opening {
    max-width: 660px;
    margin: 18px auto 28px;
    text-align: center;
  }
  .opening p {
    font-family: var(--font-reading);
    font-size: 1.02rem;
    line-height: 1.65;
    color: var(--text-body);
    font-weight: 400;
    margin-bottom: 12px;
  }
  .opening p:last-child { margin-bottom: 0; }
  .opening p .lede {
    font-style: italic;
    color: var(--text-primary);
  }

  /* ── Section headers ── */
  /* Margin-bottom cut from 88px → ~48px to match the tighter rhythm
     of About + Guidebook. */
  .section { margin-bottom: clamp(28px, 4vw, 48px); scroll-margin-top: 110px; }
  .section-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin-bottom: 8px;
    /* Card-brass shimmer with visible peak on cream paper. */
    background: var(--card-brass);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    background-clip: text;
    filter: var(--card-brass-shadow);
    display: inline-block;
    font-weight: 500;
  }
  .section-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3vw + 0.6rem, 2.2rem);
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: 14px;
    line-height: 1.15;
  }
  .section-title em {
    font-style: italic;
    font-weight: 400;
    background: var(--card-brass);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    background-clip: text;
    filter: var(--card-brass-shadow);
  }
  .section-lede {
    font-family: var(--font-reading);
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 640px;
    margin-bottom: 32px;
    font-weight: 400;
  }
  .section-divider {
    height: 1px;
    background: linear-gradient(to right, var(--border-rule), transparent 55%);
    margin-bottom: 40px;
    opacity: 0.32;
  }

  /* ── Section header card (2026-05-01) ──
        Wraps eyebrow + title + lede in a paper container with a
        brass-gold left sidebar — same vocabulary as the doorway and
        Daily cadence card. Replaces the bare-text section header
        treatment for Cadence + Orders so each section reads as a
        framed unit before its content. The eyebrow / title / lede
        styles inside are inherited from the existing .section-* rules
        (overrides only trim the margins so the card has tight
        internal rhythm). */
  .section-header-card {
    position: relative;
    /* Brightened 2026-05-01 — bumped from var(--paper) (#fefcf5) to
       var(--paper-bright) (#fffdf8) so the header cards lift off the
       cream page background more clearly. Same surface vocabulary
       used for Private Draft + Discourse Layer. */
    background-color: var(--paper-bright, #fffdf8);
    background-image: var(--paper-grain);
    border: 1px solid var(--border-light);
    border-radius: var(--radius-md);
    padding: 26px 28px 24px 38px;
    margin: 0 0 32px;
    box-shadow: 0 1px 6px rgba(74, 40, 16, 0.05);
    overflow: hidden;
  }
  .section-header-card::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 5px;
    background: linear-gradient(to bottom,
      #8c5a18 0%, #b8862e 18%, #ecb438 38%,
      #fef0a0 50%,
      #ecb438 62%, #b8862e 82%, #7a5010 100%);
    border-radius: 0 2px 2px 0;
  }
  .section-header-card .section-eyebrow { margin-bottom: 8px; }
  .section-header-card .section-title   { margin-bottom: 10px; }
  .section-header-card .section-lede {
    margin-bottom: 0;
    max-width: 720px;
  }
  @media (max-width: 760px) {
    .section-header-card { padding: 20px 22px 18px 30px; margin-bottom: 22px; }
    .section-header-card::before { width: 4px; }
  }

  /* ── Trust loop callout ── */
  .trust-loop {
    background-color: var(--paper);
    background-image: var(--paper-grain);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    padding: clamp(20px, 3.5vw, 36px) clamp(20px, 4vw, 40px);
    box-shadow:
      0 1px 3px rgba(74, 40, 16, 0.04),
      0 4px 18px rgba(74, 40, 16, 0.06);
    text-align: center;
    max-width: 760px;
    margin: 0 auto;
    position: relative;
  }
  /* Wood spine, same vocabulary as About/Guidebook section cards. */
  .trust-loop::before {
    content: ""; position: absolute;
    top: clamp(8px, 1.5vw, 14px); bottom: clamp(8px, 1.5vw, 14px);
    left: 0; width: 3px;
    background: linear-gradient(to bottom, transparent 0%, var(--burnt) 16%, var(--cherry) 50%, var(--burnt) 84%, transparent 100%);
    border-radius: 0 2px 2px 0;
  }
  .trust-loop p {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.5rem;
    line-height: 1.5;
    color: var(--text-primary);
    font-weight: 400;
  }
  .trust-loop .trust-divider {
    width: 80px;
    height: 1px;
    background: var(--gold);
    margin: 18px auto;
    opacity: 0.6;
  }

  /* ── Cadence strip ── */
  /* ── Cadence (re-stripped 2026-05-01 r2) ──
        Cards retired. Each cadence is now plain typography on the
        parchment background — name in Cormorant italic, description
        in Source Serif italic. The names graduate across the row from
        warm gold (Daily) to deep walnut (Magnum Opus), echoing the
        Orders index's family-color treatment. Vocabulary mirrors the
        Orders index list. */
  .cadence-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 24px 18px;
    margin-top: 8px;
  }
  @media (max-width: 1100px) {
    .cadence-grid { grid-template-columns: repeat(3, 1fr); gap: 28px 22px; }
  }
  @media (max-width: 640px) {
    .cadence-grid { grid-template-columns: repeat(2, 1fr); gap: 22px 18px; }
  }
  .cadence-card {
    /* All card chrome retired: no background, no border, no padding,
       no sidebar. Text lives directly on the page parchment. */
    background: none;
    background-image: none;
    border: none;
    border-radius: 0;
    box-shadow: none;
    padding: 0;
    text-align: center;
  }
  .cadence-card::before { content: none; display: none; }
  .cadence-name {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.45rem, 1.5vw + 0.6rem, 1.85rem);
    line-height: 1.05;
    margin-bottom: 6px;
    letter-spacing: -0.005em;
    /* Per-cadence color set below — graduating warm gold → deep walnut. */
    color: var(--cadence-color, var(--text-primary));
  }
  .cadence-desc {
    font-family: var(--font-reading);
    font-style: italic;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--text-secondary);
    max-width: 22ch;
    margin: 0 auto;
  }

  /* Per-cadence name color — distinct editorial palette so each cadence
     reads as its own rhythm, not a uniform brown gradient. Same
     vocabulary as the Orders family colors: each chosen for clear
     contrast on the cream parchment + an emotional fit for the rhythm
     it names. Daily wakes warm; Serial pulses burnt orange like a
     printing press; Periodical settles into olive; Quarterly waits in
     deep teal; Occasional surprises in plum; Magnum Opus closes in
     mahogany. */
  .cadence-card[data-cadence="daily"]      { --cadence-color: #c8861a; }  /* honey gold */
  .cadence-card[data-cadence="serial"]     { --cadence-color: #b85428; }  /* burnt orange / terracotta */
  .cadence-card[data-cadence="periodical"] { --cadence-color: #587028; }  /* olive sage */
  .cadence-card[data-cadence="quarterly"]  { --cadence-color: #1f5a78; }  /* deep teal */
  .cadence-card[data-cadence="occasional"] { --cadence-color: #6a2858; }  /* plum / mulberry */
  .cadence-card[data-cadence="magnum"]     { --cadence-color: #5a2818; }  /* mahogany */
  .cadence-name {
    font-family: var(--font-display);
    font-size: 1.18rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 4px;
  }
  .cadence-desc {
    font-family: var(--font-reading);
    font-size: 0.86rem;
    color: var(--text-secondary);
    line-height: 1.5;
    font-weight: 400;
  }

  /* ── Family blocks ──
     2026-04-29: each family carries its own --family-color, scoped via
     id selectors below. The color seeds three surfaces:
       1. .family-label (eyebrow) — solid family color, replacing the
          brass-shimmer treatment that was identical across every
          family and made them indistinguishable at a glance.
       2. .family-rule (hairline trailing the title) — gradient
          starting in the family color so the title group reads as a
          colored tab.
       3. Each .order-card inside the family — a 4px left accent in
          the family color, consistent with the wood-spine vocabulary
          on About + Guidebook section cards.
     The family-name keeps the brass treatment (it's the strongest
     editorial gesture available) but is bumped one size tier so it
     dominates the order-name below it instead of being overshadowed
     by the per-card archetype names. */
  .family {
    margin-bottom: clamp(28px, 4vw, 48px);
    scroll-margin-top: 110px;
    /* Default family color (used if the id-scoped rule below misses) */
    --family-color: var(--gold-muted);
  }
  /* Per-family color tokens. Drawn from the canonical topic palette so
     they read as part of the system, not foreign. Adjust in place. */
  #family-essayistic    { --family-color: #b87a18; }  /* warm gold */
  #family-argumentative { --family-color: #9e2020; }  /* cherry red */
  #family-synthetic     { --family-color: #6a3a9a; }  /* purple */
  #family-scholarly     { --family-color: #2650a0; }  /* deep blue */
  #family-narrative     { --family-color: #8a2858; }  /* rose */
  #family-practitioner  { --family-color: #287858; }  /* forest */
  #family-journalistic  { --family-color: #dc5418; }  /* burnt orange */
  #family-pedagogical   { --family-color: #267080; }  /* teal */
  #family-speculative   { --family-color: #3a3888; }  /* indigo */
  #family-declared      { --family-color: #b8862e; }  /* brass */
  .family-header {
    margin-bottom: 22px;
    display: flex;
    align-items: baseline;
    gap: 18px;
  }
  .family-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 600;
    /* Solid family color — was card-brass for every family, which made
       the labels visually identical and surrendered the chance for
       a one-glance distinction between sections. */
    color: var(--family-color);
    /* Defensive: clear any inherited gradient-clip set by ancestor
       rules (e.g. when the page is rendered without our scoped rule
       reaching due to specificity gotchas). */
    background: none;
    -webkit-background-clip: initial;
    -webkit-text-fill-color: currentColor;
    background-clip: initial;
    filter: none;
  }
  .family-name {
    font-family: var(--font-display);
    /* Bumped a tier: was clamp(1.4, 2vw+0.7, 1.8), now larger so it
       reads as the section header it is. The per-card .order-name
       (1.6rem) was previously near-equal or larger than the family
       label, inverting the visual hierarchy. */
    font-size: clamp(1.7rem, 2.5vw + 0.9rem, 2.4rem);
    font-weight: 500;
    font-style: italic;
    line-height: 1.05;
    /* Italic family titles keep the brass treatment — same rhythm as
       the About + Guidebook section title em words — because the
       family color is already carrying the family identity in the
       label, rule, and card accents. Two color cues on the title
       (brass + family) would compete; one is plenty. */
    background: var(--card-brass);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    background-clip: text;
    filter: var(--card-brass-shadow);
  }
  .family-rule {
    flex: 1;
    height: 2px;
    /* Family-colored leader: starts in the family color and fades to
       transparent. Was a generic --border-rule fade for every family. */
    background: linear-gradient(to right,
      var(--family-color) 0%,
      var(--family-color) 12%,
      transparent 70%);
    opacity: 0.55;
  }

  /* ── Order grid + cards ── */
  .order-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 20px;
  }
  .order-card {
    background-color: var(--paper);
    background-image: var(--paper-grain);
    /* 2026-04-29: stronger frame so the cream cards lift cleanly off
       the cream body. The previous 1px var(--border-light) on
       --paper over the body's cream gradient had ~5 units of luminance
       contrast and blurred the card edges. Bumped to border-medium and
       a deeper drop shadow. */
    border: 1px solid var(--border-medium);
    /* Family-colored left accent — 4px solid in the family's
       --family-color. Matches the wood-spine vocabulary on About +
       Guidebook section cards but uses the family color to mark which
       family the card belongs to. */
    border-left: 4px solid var(--family-color, var(--gold-muted));
    border-radius: var(--radius-lg);
    /* Slight extra left padding to compensate for the wider accent. */
    padding: 18px 18px 16px 22px;
    box-shadow:
      0 1px 3px rgba(74, 40, 16, 0.06),
      0 6px 18px rgba(74, 40, 16, 0.09);
    position: relative;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .order-card:hover {
    transform: translateY(-2px);
