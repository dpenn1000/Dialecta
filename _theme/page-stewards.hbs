      <div class="cadence-card" data-cadence="serial">
        <div class="cadence-name">Serial</div>
        <div class="cadence-desc">Regular columnist&rsquo;s rhythm. Weekly to fortnightly.</div>
      </div>
      <div class="cadence-card" data-cadence="periodical">
        <div class="cadence-name">Periodical</div>
