  /* ─────────────────────────────────────────────────────────────────
     ORDERS SHELL — interactive family picker (2026-05-01)
     The 10 family sections are now gated behind a chip nav + index.
     Default view shows the index (one-line tagline per family);
     clicking a chip swaps in that family's sticky description +
     order cards. data-family attributes let us mirror the existing
     #family-<id> color tokens onto chips, index items, and views.
     ───────────────────────────────────────────────────────────── */
  .orders-shell { position: relative; }

  /* Family color tokens, mirrored from the #family-<id> rules above so
     chips and index items pick up the same accents the family sections
     already carry. Keep in sync. */
  .orders-shell [data-family="essayistic"]    { --family-color: #b87a18; }
  .orders-shell [data-family="argumentative"] { --family-color: #9e2020; }
  .orders-shell [data-family="synthetic"]     { --family-color: #6a3a9a; }
  .orders-shell [data-family="scholarly"]     { --family-color: #2650a0; }
  .orders-shell [data-family="narrative"]     { --family-color: #8a2858; }
  .orders-shell [data-family="practitioner"]  { --family-color: #287858; }
  .orders-shell [data-family="journalistic"]  { --family-color: #dc5418; }
  .orders-shell [data-family="pedagogical"]   { --family-color: #267080; }
  .orders-shell [data-family="speculative"]   { --family-color: #3a3888; }
  .orders-shell [data-family="declared"]      { --family-color: #b8862e; }

  /* Chips row. Sticks to the top under the sitewide nav so the picker
     stays reachable while the user scrolls through cards. */
  .orders-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    position: sticky;
    top: calc(var(--nav-height, 119px) - 1px);
    z-index: 10;
    padding: 14px 0 12px;
    margin: 0 0 8px;
    background: rgba(247, 242, 232, 0.94);
    backdrop-filter: saturate(140%) blur(6px);
    -webkit-backdrop-filter: saturate(140%) blur(6px);
    border-bottom: 1px solid rgba(184, 115, 42, 0.18);
  }
  .orders-chip {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    font-weight: 500;
    background: transparent;
    border: 1px solid rgba(184, 115, 42, 0.26);
    border-radius: 3px;
    padding: 7px 13px;
    color: #5a5248;
    cursor: pointer;
    transition: border-color 0.18s ease, background-color 0.18s ease, color 0.18s ease;
  }
  .orders-chip:hover {
    border-color: var(--family-color, rgba(184, 115, 42, 0.55));
    color: var(--family-color, #1c1814);
  }
  .orders-chip.is-active {
    border-color: var(--family-color, #7a4a14);
    background: color-mix(in srgb, var(--family-color, #b8862e) 12%, transparent);
    color: var(--family-color, #6a4a18);
    font-weight: 600;
  }
  .orders-chip[data-family="index"] {
    /* Index chip uses brass tones since it isn't a single family. */
    --family-color: #7a4a14;
    border-style: dashed;
  }
  .orders-chip[data-family="index"].is-active {
    border-style: solid;
  }

  /* View-toggle: only the view matching data-active-family is visible. */
  .orders-shell .orders-view { display: none; }
  .orders-shell[data-active-family="index"]        .orders-view[data-orders-view="index"]        { display: block; }
  .orders-shell[data-active-family="essayistic"]   .orders-view[data-orders-view="essayistic"]   { display: block; }
  .orders-shell[data-active-family="argumentative"] .orders-view[data-orders-view="argumentative"] { display: block; }
  .orders-shell[data-active-family="synthetic"]    .orders-view[data-orders-view="synthetic"]    { display: block; }
  .orders-shell[data-active-family="scholarly"]    .orders-view[data-orders-view="scholarly"]    { display: block; }
  .orders-shell[data-active-family="narrative"]    .orders-view[data-orders-view="narrative"]    { display: block; }
  .orders-shell[data-active-family="practitioner"] .orders-view[data-orders-view="practitioner"] { display: block; }
  .orders-shell[data-active-family="journalistic"] .orders-view[data-orders-view="journalistic"] { display: block; }
  .orders-shell[data-active-family="pedagogical"]  .orders-view[data-orders-view="pedagogical"]  { display: block; }
  .orders-shell[data-active-family="speculative"]  .orders-view[data-orders-view="speculative"]  { display: block; }
  .orders-shell[data-active-family="declared"]     .orders-view[data-orders-view="declared"]     { display: block; }

  /* Cross-fade in when a view appears. Subtle so the user sees the
     swap was deliberate rather than reading it as a re-flow glitch. */
  .orders-view {
    animation: orders-fade-in 0.32s cubic-bezier(0.4, 0, 0.2, 1);
  }
  @keyframes orders-fade-in {
    from { opacity: 0; transform: translateY(4px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* Index view: list of all 10 families with one-line taglines. */
  .orders-index-intro {
    margin: 18px 0 28px;
    max-width: 640px;
  }
  .orders-index-intro p {
    font-family: var(--font-reading);
    font-style: italic;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }
  .orders-index-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 4px;
  }
  @media (min-width: 720px) {
    .orders-index-list { grid-template-columns: repeat(2, 1fr); gap: 6px; }
  }
  .orders-index-item {
    margin: 0;
  }
  .orders-index-item button {
    display: block;
    width: 100%;
    text-align: left;
    background: transparent;
    border: 1px solid transparent;
    border-left: 3px solid transparent;
    border-radius: 4px;
    padding: 18px 22px;
    cursor: pointer;
    transition: background 0.18s ease, border-color 0.18s ease, transform 0.18s ease;
  }
  .orders-index-item button:hover {
    background: color-mix(in srgb, var(--family-color, #b8862e) 6%, transparent);
    border-color: rgba(184, 115, 42, 0.18);
    border-left-color: var(--family-color, var(--gold-muted));
    transform: translateX(2px);
  }
  .orders-index-name {
    display: block;
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-weight: 500;
    font-size: 1.85rem;
    line-height: 1.05;
    color: var(--family-color, var(--text-primary));
    margin-bottom: 6px;
    letter-spacing: -0.005em;
  }
  .orders-index-tagline {
    display: block;
    font-family: var(--font-reading);
    font-style: italic;
    font-size: 1.02rem;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  /* Sticky family description — the "captivating" frozen panel above
     the order cards. Uses Cormorant Garamond italic (the platform
     display font) at large size for editorial weight. Switched from
     Playfair Display 2026-05-01: less curly, more restrained register. */
  .orders-family-sticky {
    position: sticky;
    top: calc(var(--nav-height, 119px) + 56px);
    background: rgba(247, 242, 232, 0.96);
    backdrop-filter: saturate(140%) blur(6px);
    -webkit-backdrop-filter: saturate(140%) blur(6px);
    padding: 22px 0 18px;
    margin: 14px 0 28px;
    border-bottom: 1px solid color-mix(in srgb, var(--family-color, #b8862e) 28%, transparent);
    z-index: 5;
  }
  .orders-family-sticky .family-label {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 500;
    color: var(--family-color, var(--gold-muted));
    margin-bottom: 8px;
  }
  .orders-family-name {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-weight: 500;
    font-size: clamp(2.4rem, 4vw + 1rem, 3.6rem);
    margin: 2px 0 14px;
    color: var(--family-color, var(--brass-deep));
    letter-spacing: -0.005em;
    line-height: 1.02;
  }
  .orders-family-description {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.1rem, 0.7vw + 0.9rem, 1.32rem);
    line-height: 1.55;
    color: var(--text-body);
    max-width: 680px;
    margin: 0;
  }

  /* Hide the original family-header inside the gated views — the
     sticky panel above carries the family identity now. The
     #family-<id> sections still apply their --family-color through
     the inner cards so visual continuity is preserved. */
  .orders-view-family > .family > .family-header { display: none; }
  .orders-view-family > .family { margin-top: 0; padding-top: 0; }

  @media (max-width: 760px) {
    .orders-chips { gap: 4px; padding: 10px 0 8px; }
    .orders-chip  { padding: 6px 10px; font-size: 9.5px; letter-spacing: 0.1em; }
    .orders-family-sticky { padding: 16px 0 14px; margin: 10px 0 22px; }
    .orders-family-sticky { position: relative; top: auto; }
    .orders-index-name { font-size: 1.55rem; }
  }
</style>
</style>

<main class="page">

  <!-- ── Masthead ── -->
  <header class="masthead" id="opening">
