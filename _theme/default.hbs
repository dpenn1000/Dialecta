<script>
  // ─── Under-construction banner + feedback modal ──────────────────────────
  // Wires every [data-feedback-trigger] to open the modal, every
  // [data-feedback-close] to close it, and the form to POST to /api/feedback
  // with auto-captured browser/page metadata.
  (function() {
    var modal   = document.getElementById('dialecta-feedback-modal');
    if (!modal) return;
    var form    = modal.querySelector('[data-feedback-form]');
    var success = modal.querySelector('[data-feedback-success]');
    var errorEl = modal.querySelector('[data-feedback-error]');
    var submitBtn = modal.querySelector('.dialecta-feedback-submit');

    function openModal() {
      // Reset to fresh form state every open.
      form.hidden = false;
      success.hidden = true;
      errorEl.hidden = true;
      errorEl.textContent = '';
      form.reset();
      modal.hidden = false;
      modal.setAttribute('aria-hidden', 'false');
      document.documentElement.classList.add('dialecta-feedback-open');
      var firstField = form.querySelector('select, textarea, input');
      if (firstField) setTimeout(function() { firstField.focus(); }, 50);
    }

    function closeModal() {
      modal.hidden = true;
      modal.setAttribute('aria-hidden', 'true');
      document.documentElement.classList.remove('dialecta-feedback-open');
    }

    // Triggers + close handlers wired via event delegation on document so
    // dynamically-rendered triggers (e.g., placeholder content elsewhere)
    // also work without re-binding.
    document.addEventListener('click', function(e) {
      var trigger = e.target.closest('[data-feedback-trigger]');
      if (trigger) {
        e.preventDefault();
        openModal();
        return;
      }
      if (e.target.closest('[data-feedback-close]')) {
        closeModal();
      }
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && !modal.hidden) closeModal();
    });

    function captureMetadata() {
      var device = 'desktop';
      try {
        if (/Mobi|Android|iPhone|iPad/.test(navigator.userAgent)) device = 'mobile';
      } catch (_) { /* ignore */ }
      return {
        device_type: device,
        user_agent:  navigator.userAgent || null,
        viewport:    { w: window.innerWidth, h: window.innerHeight },
        page_url:    window.location.href,
        referrer:    document.referrer || null,
        language:    navigator.language || null,
        timestamp_client_iso: new Date().toISOString(),
      };
    }

    // Screenshot picker: hint line shows filename + size on selection;
    // turns red if the file exceeds 5MB. Submit-time validation also runs.
    var screenshotInput = form.querySelector('[data-feedback-screenshot]');
    var screenshotHint  = form.querySelector('[data-feedback-screenshot-hint]');
    if (screenshotInput && screenshotHint) {
      screenshotInput.addEventListener('change', function() {
        var file = screenshotInput.files && screenshotInput.files[0];
        if (!file) {
          screenshotHint.hidden = true;
          screenshotHint.classList.remove('error');
          return;
        }
        var sizeMB = (file.size / (1024 * 1024)).toFixed(1);
        if (file.size > 5 * 1024 * 1024) {
          screenshotHint.textContent = 'Too large: ' + file.name + ' (' + sizeMB + 'MB). Max 5MB.';
          screenshotHint.classList.add('error');
        } else {
          screenshotHint.textContent = file.name + ' · ' + sizeMB + 'MB';
          screenshotHint.classList.remove('error');
        }
        screenshotHint.hidden = false;
      });
    }

    function readScreenshotAsDataUrl() {
      return new Promise(function(resolve) {
        var file = screenshotInput && screenshotInput.files && screenshotInput.files[0];
        if (!file) return resolve(null);
        if (file.size > 5 * 1024 * 1024) return resolve({ error: 'too_large' });
        var reader = new FileReader();
        reader.onload  = function() { resolve({ data_url: reader.result }); };
        reader.onerror = function() { resolve({ error: 'read_failed' }); };
        reader.readAsDataURL(file);
      });
    }

    form.addEventListener('submit', function(e) {
      e.preventDefault();
      errorEl.hidden = true;
      errorEl.textContent = '';
      submitBtn.disabled = true;
      var origLabel = submitBtn.textContent;
      submitBtn.textContent = 'Sending…';

      readScreenshotAsDataUrl().then(function(screenshot) {
        if (screenshot && screenshot.error === 'too_large') {
          throw new Error('Screenshot too large (5MB max).');
        }
        if (screenshot && screenshot.error === 'read_failed') {
          throw new Error('Could not read the screenshot file.');
        }

        var fd = new FormData(form);
        var payload = {
          type:              fd.get('type') || 'idea',
          title:             (fd.get('title') || '').trim() || null,
          body:              (fd.get('body') || '').trim(),
          captured_metadata: captureMetadata(),
        };
        if (screenshot && screenshot.data_url) {
          payload.screenshot = { data_url: screenshot.data_url };
        }

        var apiBase = window.__DIALECTA_API_URL__ || '';
        var memberUuid = window.__DIALECTA_MEMBER_UUID__ || null;
        var url = apiBase + '/api/feedback' + (memberUuid ? '?member_id=' + encodeURIComponent(memberUuid) : '');

        return fetch(url, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify(payload),
        });
      })
        .then(function(r) {
          if (!r) return;
          if (!r.ok) {
            return r.json().catch(function(){ return {}; }).then(function(j) {
              throw new Error(j.error || 'HTTP ' + r.status);
            });
          }
          form.hidden = true;
          success.hidden = false;
        })
        .catch(function(err) {
          errorEl.textContent = err.message || 'Submission failed.';
          errorEl.hidden = false;
        })
        .finally(function() {
          submitBtn.disabled = false;
          submitBtn.textContent = origLabel;
        });
    });
  })();
</script>

<!-- ── BYLINE OVERRIDE FOR FEED CARDS (Path C-lite Phase 1D) ──
     Article cards across the site (page-articles.hbs, index.hbs, anywhere
     else .post-card[data-post-id] appears) display Ghost's primary_author
     name in the rendered HTML. For member-written articles that's the
     house staff user (Daniel) since all member articles attribute server-
     side to the house identity. The real author lives in
     articles.author_member_id → profiles.display_name.
     This script collects all post IDs on the page, makes one bulk lookup,
     and patches each card's .post-card-author span with the real name.
     Cards without a Supabase row (legacy articles) silently keep Ghost's
     byline. Early-exits cleanly on pages with no .post-card[data-post-id].  -->
<script>
  (function() {
    var cards = document.querySelectorAll('.post-card[data-post-id]');
    if (cards.length === 0) return;
    var ids = [];
    cards.forEach(function(c) {
      var id = c.getAttribute('data-post-id');
      if (id) ids.push(id);
    });
    if (ids.length === 0) return;
    var apiBase = (window.__DIALECTA_API_URL__ || '').replace(/\/$/, '');
    fetch(apiBase + '/api/article/_authors?ids=' + encodeURIComponent(ids.join(',')))
      .then(function(r) { return r.ok ? r.json() : null; })
      .then(function(data) {
        if (!data || !data.authors) return;
        cards.forEach(function(card) {
          var id = card.getAttribute('data-post-id');
          var author = data.authors[id];
          if (!author || !author.display_name) return;
          var nameEl = card.querySelector('.post-card-author');
          if (!nameEl) return;
          nameEl.textContent = author.display_name;
          if (nameEl.tagName === 'A' && author.member_id) {
            nameEl.setAttribute('href', '/profile/?id=' + encodeURIComponent(author.member_id));
          }
        });
      })
      .catch(function() { /* swallow — Ghost byline is the fallback */ });
  })();
</script>

