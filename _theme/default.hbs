<script>
  // Drawer admin shortcuts. Populates .nav-drawer-admin-links from the
  // member's effective_capabilities array on /api/profile/<uuid> (added in
  // migration 017_admin_rbac). Hidden by default; un-hides only if the
  // member has at least one admin role. Quiet failure if the API is
  // unreachable (members without admin grants see nothing either way).
  (function() {
    var adminEl = document.querySelector('.nav-drawer-admin-links[data-member-uuid]');
    if (!adminEl) return;
    var uuid = adminEl.getAttribute('data-member-uuid');
    if (!uuid) return;
    var apiBase = window.__DIALECTA_API_URL__ || '';

    fetch(apiBase + '/api/profile/' + uuid)
      .then(function(r) { return r.ok ? r.json() : null; })
      .then(function(p) {
        if (!p) return;
        var roles = p.admin_roles || [];
        var caps  = p.effective_capabilities || [];
        if (roles.length === 0) return;

        // Each entry: a capability test → drawer link. Order = display
        // order. Placeholder hrefs for v1; the /dev-admin/ page comes next.
        // All admin destinations are tabs inside the single /dev-admin/ Ghost
        // page, deep-linked via ?tab=<id>. Quote Library is the lone external
        // shortcut since it lives at /quotes/ and predates /dev-admin/.
        var ITEMS = [
          { test: function() { return roles.length > 0; },
            label: 'Dev Admin',     href: '/dev-admin/' },
          { test: function() { return caps.indexOf('quotes.curate') !== -1; },
            label: 'Quote Library', href: '/quotes/?admin=true' },
          { test: function() {
              return ['articles.repolish','articles.reclassify','articles.archive']
                .some(function(c) { return caps.indexOf(c) !== -1; });
            },
            label: 'Article Tools', href: '/dev-admin/?tab=articles' },
          { test: function() { return caps.indexOf('members.manage_roles') !== -1; },
            label: 'Manage Team',   href: '/dev-admin/?tab=team' },
          { test: function() { return caps.indexOf('tuning.read') !== -1; },
            label: 'Tuning',        href: '/dev-admin/?tab=tuning' }
        ];

        var visibleCount = 0;
        ITEMS.forEach(function(item) {
          if (!item.test()) return;
          var a = document.createElement('a');
          a.href = item.href;
          a.textContent = item.label;
          adminEl.appendChild(a);
          visibleCount++;
        });

        if (visibleCount > 0) {
          adminEl.removeAttribute('hidden');
        }
      })
      .catch(function() { /* quiet */ });
  })();
</script>
{{/if}}

