<!-- ═══ MISSION ═══ -->
<section class="parchment parchment-long fade-in">
  <div class="parchment-edges"></div>
  <svg class="parchment-crinkles" viewBox="0 0 1000 2800" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <filter id="lw1" x="-20%" y="-20%" width="140%" height="140%"><feTurbulence type="fractalNoise" baseFrequency="0.012" numOctaves="2" seed="11"/><feDisplacementMap in="SourceGraphic" scale="18"/></filter>
        <filter id="lw2" x="-20%" y="-20%" width="140%" height="140%"><feTurbulence type="fractalNoise" baseFrequency="0.018" numOctaves="2" seed="19"/><feDisplacementMap in="SourceGraphic" scale="12"/></filter>
        <filter id="lb1"><feGaussianBlur stdDeviation="0.6"/></filter>
      </defs>
      <g filter="url(#lw1)" opacity="0.65">
        <path d="M 80 120 Q 260 180, 430 210 T 780 260" fill="none" stroke="#8c4a2f" stroke-width="0.6" stroke-linecap="round" filter="url(#lb1)"/>
        <path d="M 120 530 Q 320 560, 500 540 T 900 580" fill="none" stroke="#8c4a2f" stroke-width="0.5" stroke-linecap="round" filter="url(#lb1)"/>
        <path d="M 200 860 Q 380 900, 560 880 T 860 920" fill="none" stroke="#5a2410" stroke-width="0.4" stroke-linecap="round" filter="url(#lb1)"/>
        <path d="M 80 1220 Q 260 1280, 430 1310 T 780 1360" fill="none" stroke="#8c4a2f" stroke-width="0.6" stroke-linecap="round" filter="url(#lb1)"/>
        <path d="M 120 1630 Q 320 1660, 500 1640 T 900 1680" fill="none" stroke="#8c4a2f" stroke-width="0.5" stroke-linecap="round" filter="url(#lb1)"/>
        <path d="M 200 1960 Q 380 2000, 560 1980 T 860 2020" fill="none" stroke="#5a2410" stroke-width="0.4" stroke-linecap="round" filter="url(#lb1)"/>
        <path d="M 80 2320 Q 260 2380, 430 2410 T 780 2460" fill="none" stroke="#8c4a2f" stroke-width="0.6" stroke-linecap="round" filter="url(#lb1)"/>
      </g>
