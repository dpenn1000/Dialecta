{{!< default}}
{{!--
  page-pact.hbs
  ─────────────────────────────────────────────────────────────────────────
  Auto-matched to the Ghost page with slug "pact".
  Ghost's default.hbs provides: <html>, <head>, {{ghost_head}}, <body>,
  the canonical site nav, and {{ghost_foot}}.
  This template adds: pact-specific CSS, the full pact content, and the
  inline JS for the quiz and commitment flow.

  Font stack: the Google Fonts import is included here inline because the
  pact uses display weights not loaded globally by default.hbs. If you
  later centralise fonts in default.hbs, remove the <link> below.
  ─────────────────────────────────────────────────────────────────────────
--}}

{{#post}}

<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,300;1,400;1,500&family=Source+Serif+4:ital,wght@0,300;0,400;0,500;1,300;1,400&family=DM+Sans:wght@400;500&family=DM+Mono:wght@400;500&family=Mrs+Saint+Delafield&family=Allura&display=swap" rel="stylesheet">

<style>
  /* ── Page-specific CSS ──────────────────────────────────────────────────
     default.hbs owns the body background and nav styles.
     Everything below is scoped to the Pact page only.
     ─────────────────────────────────────────────────────────────────────── */
  :root {
    --ink:          #1c1814;
    --ink-soft:     #2c2620;
    --body:         #3a342c;
    --text-prose:   #5e6066;
    --text-lede:    #2c2620;
    --secondary:    #5a5248;
    --tertiary:     #7a7068;
    --gold:         #d4a84a;
    --gold-bright:  #e8a830;
    --amber:        #b8732a;
    --terra:        #8c4a2f;
    --ox:           #5a2410;
    --cream:        #f7f2e8;
    --dark-card:    #292b2d;
    --font-display: 'Cormorant Garamond', serif;
    --font-reading: 'Source Serif 4', Georgia, serif;
    --font-body:    'DM Sans', sans-serif;
    --font-mono:    'DM Mono', monospace;
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  html { scroll-behavior: smooth; -webkit-font-smoothing: antialiased; }

  /* ═══ PAGE LAYOUT ═══ */
  .page {
    /* Top pad was 106px — leftover clearance from when this page had
       its own fixed nav. The .page-template site-main is already
       zeroed and default.hbs's nav is sticky (not fixed-clearance), so
       106px was 80px of dead space above the hero. */
    padding: 0 clamp(16px, 3vw, 24px) clamp(40px, 5vw, 64px);
    position: relative;
    z-index: 1;
  }
  .pact-stage {
    max-width: 1060px;
    margin: 0 auto;
  }

  /* ═══ ANTIQUE PAPER SURFACE — shared by every section card ═══ */
  .parchment {
    position: relative;
    background:
      radial-gradient(ellipse at 22% 18%, rgba(232, 200, 140, 0.18) 0%, transparent 42%),
      radial-gradient(ellipse at 78% 78%, rgba(184, 115, 42, 0.10) 0%, transparent 50%),
      radial-gradient(ellipse at 88% 12%, rgba(140, 74, 47, 0.08) 0%, transparent 38%),
      radial-gradient(ellipse at 12% 92%, rgba(212, 168, 74, 0.12) 0%, transparent 45%),
      linear-gradient(165deg, #efe2c4 0%, #ead7b3 35%, #f0e2bf 70%, #e8d3aa 100%);
    border-radius: 6px;
    overflow: hidden;
    box-shadow:
      inset 0 0 0 1px rgba(140, 74, 47, 0.18),
      inset 0 0 0 9px rgba(140, 74, 47, 0.12),
      0 2px 12px rgba(28, 24, 20, 0.10),
      0 12px 48px rgba(28, 24, 20, 0.08);
    margin-bottom: 32px;
  }
  .parchment::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='240' height='240'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' seed='4'/><feColorMatrix type='matrix' values='0 0 0 0 0.55  0 0 0 0 0.36  0 0 0 0 0.18  0 0 0 0.55 0'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
    opacity: 0.18;
    mix-blend-mode: multiply;
    pointer-events: none;
    border-radius: 6px;
    z-index: 0;
  }
  .parchment::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 8% 14%, rgba(140, 74, 47, 0.16) 0%, transparent 1.2%),
      radial-gradient(circle at 92% 22%, rgba(140, 74, 47, 0.12) 0%, transparent 0.8%),
      radial-gradient(circle at 14% 88%, rgba(140, 74, 47, 0.18) 0%, transparent 1.0%),
      radial-gradient(circle at 78% 92%, rgba(140, 74, 47, 0.14) 0%, transparent 1.1%),
      radial-gradient(circle at 56% 8%, rgba(140, 74, 47, 0.10) 0%, transparent 0.7%),
      radial-gradient(circle at 32% 56%, rgba(140, 74, 47, 0.09) 0%, transparent 0.5%),
      radial-gradient(circle at 88% 52%, rgba(140, 74, 47, 0.13) 0%, transparent 0.9%),
      radial-gradient(circle at 46% 38%, rgba(140, 74, 47, 0.07) 0%, transparent 0.4%),
      radial-gradient(ellipse 14px 3px at 70% 30%, rgba(140, 74, 47, 0.14) 0%, transparent 100%),
      radial-gradient(ellipse 8px 2px at 18% 68%, rgba(140, 74, 47, 0.12) 0%, transparent 100%);
    pointer-events: none;
    border-radius: 6px;
    z-index: 0;
  }
  .parchment-edges, .parchment-crinkles {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
    border-radius: 6px;
  }
  .parchment-edges {
    background:
      radial-gradient(ellipse 180px 120px at 0% 0%, rgba(90, 50, 24, 0.10) 0%, transparent 70%),
      radial-gradient(ellipse 180px 120px at 100% 0%, rgba(90, 50, 24, 0.08) 0%, transparent 70%),
      radial-gradient(ellipse 200px 140px at 0% 100%, rgba(90, 50, 24, 0.12) 0%, transparent 70%),
      radial-gradient(ellipse 200px 140px at 100% 100%, rgba(90, 50, 24, 0.10) 0%, transparent 70%);
  }
  .parchment-crinkles {
    opacity: 0.28;
    mix-blend-mode: multiply;
  }

  .parchment-inner {
    position: relative;
    z-index: 2;
    /* Refresh-2026-04-29: Padding cut substantially. Was 72px 88px on
       desktop — far too much breathing room for a heading-led page,
       and titles were running outside the parchment on tablets due
       to the wide horizontal pad eating the available text width.
       Now fluid, capped much lower. */
    padding: clamp(28px, 4vw + 8px, 56px) clamp(20px, 4vw, 48px);
  }
  .parchment-long .parchment-inner {
    /* Long-form sections (philosophy + tiers + commit) get a touch
       more vertical room than the hero, but still well under the
       previous 88/96 maxes. */
    padding: clamp(32px, 4vw + 12px, 64px) clamp(20px, 4vw, 48px) clamp(36px, 4vw + 16px, 72px);
  }

  /* ═══ TYPOGRAPHY ═══ */
  .eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    margin-bottom: 22px;
    background: linear-gradient(125deg,
      #5a3a10 0%,
      #a07828 35%,
      #d4a84a 55%,
      #7a5218 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    filter:
      drop-shadow(0 1px 0 rgba(28, 24, 20, 0.55));
    display: inline-block;
  }
  h1.display {
    font-family: var(--font-display);
    /* Caps reduced — at the previous 6rem max some hero titles were
       running past the parchment edge on mid-width screens. Word-wrap
       belt-and-braces in case a single long word forces overflow. */
    font-size: clamp(2.6rem, 6vw, 4.6rem);
    font-weight: 600;
    color: var(--ink);
    line-height: 1.04;
    letter-spacing: -0.012em;
    margin-bottom: 26px;
    overflow-wrap: break-word;
    max-width: 100%;
  }
  h2.display {
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 4vw + 0.4rem, 3rem);
    font-weight: 600;
    color: var(--ink);
    line-height: 1.08;
    letter-spacing: -0.01em;
    margin-bottom: 22px;
    overflow-wrap: break-word;
    max-width: 100%;
  }
  h1.display em, h2.display em {
    font-weight: 400;
    font-style: italic;
    background: linear-gradient(180deg,
      #6f4e1a 0%,
      #a07828 10%,
      #d4a84a 24%,
      #f0d07a 42%,
      #e8c366 54%,
      #c99438 72%,
      #8c5e1e 88%,
      #5a3a10 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    filter:
      drop-shadow(0 1px 0 rgba(28, 24, 20, 0.55))
      drop-shadow(0 2px 0 rgba(90, 36, 16, 0.22));
  }
  p.lede {
    font-family: var(--font-reading);
    font-size: 1.18rem;
    font-weight: 300;
    font-style: italic;
    color: var(--text-lede);
    line-height: 1.65;
    max-width: 52ch;
    margin-bottom: 24px;
  }
  p.body {
    font-family: var(--font-reading);
    font-size: 1.02rem;
    font-weight: 400;
    color: var(--text-prose);
    line-height: 1.8;
    max-width: 60ch;
    margin-bottom: 24px;
  }
  p.body strong {
    color: var(--ink-soft);
    font-weight: 500;
  }
  .rule {
    width: 72px;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--terra), transparent);
    margin: 28px 0;
  }
  .divider {
    width: 100%;
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(140, 74, 47, 0.25), transparent);
    margin: 48px 0;
  }

  /* Pull quote callout */
  .callout {
    position: relative;
    margin: 36px 0;
    padding: 28px 32px 28px 40px;
    border-left: 3px solid var(--terra);
    background: rgba(245, 232, 208, 0.4);
    border-radius: 0 4px 4px 0;
    max-width: 60ch;
  }
  .callout p {
    font-family: var(--font-display);
    font-size: 1.3rem;
    font-style: italic;
    font-weight: 400;
    color: var(--ink-soft);
    line-height: 1.5;
    margin-bottom: 10px;
  }
  .callout .attribution {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-style: normal;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--terra);
    margin-bottom: 0;
  }

  /* ═══ CORNER ORNAMENTS ═══ */
  .corner-mark {
    position: absolute;
    top: 36px;
    right: 44px;
    font-family: var(--font-display);
    font-size: 0.65rem;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--terra);
    z-index: 2;
    text-align: right;
    line-height: 1.6;
  }
  .corner-mark .mark-rule {
    display: block;
    width: 32px; height: 1px;
    background: var(--terra);
    margin: 6px 0 6px auto;
    opacity: 0.5;
  }
  .corner-mark .mark-sub {
    font-family: var(--font-mono);
    font-size: 0.52rem;
    color: var(--amber);
    letter-spacing: 0.22em;
  }
  .folio {
    position: absolute;
    bottom: 28px;
    right: 44px;
    font-family: var(--font-display);
    font-size: 0.7rem;
    font-style: italic;
    color: rgba(140, 74, 47, 0.55);
    z-index: 2;
    letter-spacing: 0.08em;
  }

  /* ═══ TIER LIST — stacked typographic rows ═══ */
  .tier-list { margin-top: 48px; }
  .tier-row {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 32px;
    padding: 32px 0;
    border-top: 1px dotted rgba(140, 74, 47, 0.28);
    align-items: start;
  }
  .tier-row:first-child { border-top: none; padding-top: 16px; }
  .tier-row-icon {
    padding-top: 10px;
    display: flex; justify-content: flex-start;
  }
  .tier-row-icon .tier-svg { width: 48px; height: 48px; }
  .tier-row-kicker {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--terra);
    margin-bottom: 8px;
    display: block;
  }
  .tier-row-name {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 3.4vw, 3rem);
    font-weight: 600;
    font-style: italic;
    color: var(--ink);
    line-height: 0.95;
    margin-bottom: 18px;
    letter-spacing: -0.01em;
  }
  .tier-row-desc {
    font-family: var(--font-reading);
    font-size: 1.06rem;
    color: var(--text-prose);
    line-height: 1.75;
    max-width: 62ch;
  }
  .tier-row-desc::first-letter {
    font-family: var(--font-display);
    font-size: 3.6rem;
    font-weight: 500;
    font-style: normal;
    float: left;
    line-height: 0.82;
    padding: 6px 10px 0 0;
    color: var(--terra);
  }
  .tier-forum  .tier-row-icon .tier-svg { color: #a07828; }
  .tier-spark  .tier-row-icon .tier-svg { color: #b0b860; }
  .tier-echo   .tier-row-icon .tier-svg { color: #708848; }
  .tier-fog    .tier-row-icon .tier-svg { color: #687488; }
  .tier-heat   .tier-row-icon .tier-svg { color: #b8732a; }
  .tier-stance .tier-row-icon .tier-svg { color: #783028; }
  .tier-breach .tier-row-icon .tier-svg { color: #5a1818; }
  .tier-forum  .tier-row-desc::first-letter { color: #a07828; }
  .tier-spark  .tier-row-desc::first-letter { color: #8c8018; }
  .tier-echo   .tier-row-desc::first-letter { color: #708848; }
  .tier-fog    .tier-row-desc::first-letter { color: #5e6a7c; }
  .tier-heat   .tier-row-desc::first-letter { color: #b8732a; }
  .tier-stance .tier-row-desc::first-letter { color: #783028; }
  .tier-breach .tier-row-desc::first-letter { color: #5a1818; }

  /* ═══ INLINE SECTION MARKER (for the long card) ═══ */
  .section-mark {
    display: flex;
    align-items: center;
    gap: 20px;
    margin: 72px 0 56px;
    padding: 0;
  }
  .section-mark::before, .section-mark::after {
    content: "";
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, transparent, rgba(140, 74, 47, 0.45), transparent);
  }
  .section-mark-num {
    font-family: var(--font-display);
    font-size: 1.9rem;
    font-style: italic;
    font-weight: 500;
    color: var(--terra);
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  /* ═══ STAGE LIST (how it works) ═══ */
  .stage-list { margin-top: 32px; }
  .stage {
    display: flex;
    gap: 28px;
    align-items: flex-start;
    padding: 20px 0;
    border-bottom: 1px dotted rgba(140, 74, 47, 0.22);
  }
  .stage:last-child { border-bottom: none; }
  .stage-num {
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-style: italic;
    font-weight: 400;
    background: linear-gradient(180deg,
      #6f4e1a 0%,
      #a07828 10%,
      #d4a84a 24%,
      #f0d07a 42%,
      #e8c366 54%,
      #c99438 72%,
      #8c5e1e 88%,
      #5a3a10 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    filter:
      drop-shadow(0 1px 0 rgba(28, 24, 20, 0.55))
      drop-shadow(0 2px 0 rgba(90, 36, 16, 0.22));
    min-width: 60px;
    line-height: 1;
    padding-top: 4px;
  }
  .stage-title {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 6px;
    line-height: 1.2;
  }
  .stage-body {
    font-family: var(--font-reading);
    font-size: 1rem;
    color: var(--text-prose);
    line-height: 1.7;
    max-width: 58ch;
  }
  .stage-body strong { color: var(--ink-soft); font-weight: 500; }

  /* ═══ WAIT GRID ═══ */
  .wait-grid {
    margin-top: 32px;
    border-top: 1px solid rgba(140, 74, 47, 0.22);
  }
  .wait-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 18px 0;
    border-bottom: 1px dotted rgba(140, 74, 47, 0.22);
    gap: 24px;
  }
  .wait-label {
    font-family: var(--font-reading);
    font-size: 1rem;
    color: var(--text-prose);
  }
  .wait-time {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-style: italic;
    font-weight: 500;
    background: linear-gradient(180deg,
      #6f4e1a 0%,
      #a07828 10%,
      #d4a84a 24%,
      #f0d07a 42%,
      #e8c366 54%,
      #c99438 72%,
      #8c5e1e 88%,
      #5a3a10 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    filter:
      drop-shadow(0 1px 0 rgba(28, 24, 20, 0.55))
      drop-shadow(0 2px 0 rgba(90, 36, 16, 0.22));
    white-space: nowrap;
  }

  /* ═══ GROWTH GRID ═══ */
  .growth-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
    margin-top: 32px;
  }
  .growth-card {
    padding: 24px 26px;
    background: rgba(255, 253, 248, 0.5);
    border: 1px solid rgba(140, 74, 47, 0.18);
    border-radius: 4px;
    border-top: 2px solid var(--gold-bright);
  }
  .growth-tag {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--amber);
    margin-bottom: 10px;
  }
  .growth-card-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 8px;
    line-height: 1.2;
  }
  .growth-card-sub {
    font-family: var(--font-reading);
    font-size: 0.92rem;
    color: var(--text-prose);
    line-height: 1.55;
  }

  /* ═══ QUIZ ═══ */
  .quiz-intro {
    font-family: var(--font-reading);
    font-size: 1.08rem;
    font-style: italic;
    color: var(--text-lede);
    line-height: 1.65;
    max-width: 54ch;
    margin-bottom: 40px;
  }
  .quiz-card {
    display: none;
    padding: 32px 36px;
    background: rgba(255, 253, 248, 0.65);
    border: 1px solid rgba(140, 74, 47, 0.22);
    border-radius: 4px;
    margin-bottom: 16px;
  }
  .quiz-card.active { display: block; }
  .quiz-count {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--terra);
    margin-bottom: 16px;
  }
  .quiz-comment {
    font-family: var(--font-reading);
    font-size: 1.1rem;
    font-style: italic;
    color: var(--ink-soft);
    line-height: 1.6;
    padding: 18px 22px;
    background: rgba(140, 74, 47, 0.06);
    border-left: 3px solid var(--terra);
    border-radius: 0 3px 3px 0;
    margin-bottom: 24px;
  }
  .quiz-options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 10px;
    margin-bottom: 20px;
  }
  .quiz-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 18px;
    background: rgba(255, 253, 248, 0.7);
    border: 1px solid rgba(140, 74, 47, 0.25);
    border-radius: 3px;
    font-family: var(--font-display);
    font-size: 1.05rem;
    color: var(--ink);
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
  }
  .quiz-btn:hover:not(:disabled) {
    background: rgba(245, 232, 208, 0.8);
    border-color: var(--terra);
  }
  .quiz-btn .tier-svg { width: 16px; height: 16px; flex-shrink: 0; }
  .quiz-btn:disabled { cursor: default; opacity: 0.7; }
  .quiz-btn.correct {
    background: rgba(212, 168, 74, 0.25);
    border-color: var(--gold-bright);
    color: var(--ink);
    opacity: 1;
  }
  .quiz-btn.incorrect {
    background: rgba(184, 115, 42, 0.15);
    border-color: var(--amber);
    color: var(--ink-soft);
    opacity: 1;
  }
  .quiz-btn.revealed {
    background: rgba(212, 168, 74, 0.18);
    border-color: var(--gold);
    opacity: 1;
  }
  .quiz-feedback {
    display: none;
    margin-top: 16px;
    padding: 18px 22px;
    background: rgba(245, 232, 208, 0.5);
    border-left: 3px solid var(--gold);
    border-radius: 0 3px 3px 0;
    font-family: var(--font-reading);
    font-size: 0.95rem;
    color: var(--ink-soft);
    line-height: 1.65;
  }
  .quiz-feedback.visible { display: block; }
  .quiz-feedback strong { font-weight: 600; color: var(--ink); }
  .quiz-next {
    display: none;
    margin-top: 16px;
    padding: 10px 24px;
    background: transparent;
    border: 1px solid var(--terra);
    color: var(--terra);
    font-family: var(--font-display);
    font-size: 1rem;
    font-style: italic;
    border-radius: 3px;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }
  .quiz-next.visible { display: inline-block; }
  .quiz-next:hover { background: var(--terra); color: var(--cream); }
  .quiz-complete {
    display: none;
    text-align: center;
    padding: 40px 32px;
  }
  .quiz-complete.visible { display: block; }
  .quiz-score {
    font-family: var(--font-display);
    font-size: 4rem;
    font-weight: 600;
    font-style: italic;
    background: linear-gradient(180deg,
      #6f4e1a 0%,
      #a07828 10%,
      #d4a84a 24%,
      #f0d07a 42%,
      #e8c366 54%,
      #c99438 72%,
      #8c5e1e 88%,
      #5a3a10 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    filter:
      drop-shadow(0 1px 0 rgba(28, 24, 20, 0.55))
      drop-shadow(0 2px 0 rgba(90, 36, 16, 0.22));
    line-height: 1;
  }
  .quiz-score-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--amber);
    margin-top: 10px;
    margin-bottom: 24px;
  }
  .quiz-message {
    font-family: var(--font-reading);
    font-size: 1.08rem;
    font-style: italic;
    color: var(--ink-soft);
    line-height: 1.6;
    max-width: 50ch;
    margin: 0 auto;
  }

  /* ═══ COMMITMENT ═══ */
  .pact-text {
    font-family: var(--font-reading);
    font-size: 1.15rem;
    font-style: italic;
    color: var(--ink-soft);
    line-height: 1.75;
    max-width: 56ch;
    margin: 0 auto 32px;
    text-align: center;
  }
  /* Path A / Path B selection styles removed 2026-04-29 along with the
     UI block. The choice moved to the post composer where it applies. */
  .commit-wrap { text-align: center; margin-top: 8px; }

  /* ═══ COMMITTED-SEALED STATE ═══
     Applied to the .commit-form on successful commit. The form does not
     hide; instead the signature "hardens" on the page (readonly, brass-
     bright underline, no editable affordance) and the button is replaced
     with a Begin → link. This gives the new member a clear, persistent
     visual record of what they signed and an obvious next step, instead
     of a hidden form they might think failed. */
  .commit-form.committed-sealed .signature-input {
    pointer-events: none;
    cursor: default;
    caret-color: transparent;
    color: var(--brass-deep, #6a4a18);
  }
  .commit-form.committed-sealed .signature-line {
    border-bottom-color: var(--gold-bright, #d4a84a);
    border-bottom-width: 2px;
  }
  .commit-form.committed-sealed .signature-prompt {
    color: var(--brass-warm, #b8862e);
    letter-spacing: 0.18em;
    font-style: normal;
  }
  .commit-form.committed-sealed .signature-name-label {
    color: var(--tertiary);
    font-style: italic;
  }
  /* The "Begin →" CTA is an <a> styled to inherit the .brass treatment.
     Add link-specific resets (no underline, inline-block) so it renders
     as a button. */
  .committed-cta {
    text-decoration: none;
    display: inline-block;
  }
  .committed-cta:hover { text-decoration: none; }

  /* ═══ BRASS BUTTON ═══ */
  .brass {
    position: relative;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #3a2410;
    padding: 16px 40px;
    cursor: pointer;
    border: none;
    border-radius: 3px;
    background:
      linear-gradient(180deg,
        #6f4e1a 0%, #a07828 6%, #d4a84a 18%, #f0d07a 34%,
        #e8c366 50%, #c99438 66%, #8c5e1e 84%, #5a3a10 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 240, 180, 0.65),
      inset 0 -1px 0 rgba(60, 36, 10, 0.55),
      inset 1px 0 0 rgba(255, 220, 140, 0.35),
      inset -1px 0 0 rgba(60, 36, 10, 0.35),
      0 1px 0 rgba(255, 240, 180, 0.30),
      0 2px 4px rgba(28, 24, 20, 0.28),
      0 6px 14px rgba(28, 24, 20, 0.22);
    text-shadow:
      0 1px 0 rgba(255, 236, 176, 0.55),
      0 -1px 0 rgba(60, 36, 10, 0.35);
    transition: transform 0.08s ease, box-shadow 0.15s ease, filter 0.2s ease;
  }
  .brass:hover:not(:disabled) {
    background:
      linear-gradient(180deg,
        #7a5620 0%, #ad8430 6%, #e0b452 18%, #f6d884 34%,
        #f0cc70 50%, #d4a040 66%, #956420 84%, #603e12 100%);
  }
  .brass:active:not(:disabled) {
    transform: translateY(1px);
    box-shadow:
      inset 0 1px 2px rgba(60, 36, 10, 0.40),
      inset 0 -1px 0 rgba(255, 240, 180, 0.30),
      0 1px 0 rgba(255, 240, 180, 0.20),
      0 1px 2px rgba(28, 24, 20, 0.25);
  }
  .brass:disabled {
    cursor: not-allowed;
  }

  /* ═══ COMMITTED STATE ═══ */
  .committed { display: none; text-align: center; padding: 40px 20px; }
  .committed.visible { display: block; }
  .committed-mark {
    font-family: var(--font-display);
    font-size: 3rem;
    color: var(--gold-bright);
    filter: drop-shadow(0 1px 2px rgba(28, 24, 20, 0.3));
  }
  .committed-title {
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 600;
    color: var(--ink);
    margin: 14px 0 12px;
  }
  .committed-title em {
    font-weight: 400;
    font-style: italic;
    background: linear-gradient(180deg,
      #6f4e1a 0%,
      #a07828 10%,
      #d4a84a 24%,
      #f0d07a 42%,
      #e8c366 54%,
      #c99438 72%,
      #8c5e1e 88%,
      #5a3a10 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    filter:
      drop-shadow(0 1px 0 rgba(28, 24, 20, 0.55))
      drop-shadow(0 2px 0 rgba(90, 36, 16, 0.22));
  }
  .committed-sub {
    font-family: var(--font-reading);
    font-size: 1.1rem;
    font-style: italic;
    color: var(--ink-soft);
    line-height: 1.6;
    max-width: 50ch;
    margin: 0 auto 28px;
  }

  /* ═══ FOOTER ═══ */
  .footer {
    text-align: center;
    padding: 48px 24px 24px;
    position: relative;
    z-index: 1;
  }
  .footer-mark {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--terra);
    margin-bottom: 8px;
  }
  .footer-note {
    font-family: var(--font-reading);
    font-size: 0.88rem;
    font-style: italic;
    color: var(--tertiary);
    line-height: 1.6;
    max-width: 56ch;
    margin: 0 auto;
  }



  /* ═══ RESPONSIVE ═══ */
  @media (max-width: 768px) {
    .parchment-inner { padding: 52px 32px; }
    .corner-mark { top: 20px; right: 24px; }
    .folio { bottom: 18px; right: 24px; }
    .stage { flex-direction: column; gap: 8px; }
    .stage-num { font-size: 2rem; }
    .nav-sub-inner { overflow-x: auto; }
    .nav-sub-inner a { flex-shrink: 0; }
  }

  /* ── Narrow phones: drop inner parchment padding to 20px sides so
        overflow: hidden on .parchment never clips the body content.
        Also enforce box-sizing and width so the card fills correctly. ── */
  @media (max-width: 480px) {
    .page { padding-left: 12px; padding-right: 12px; }
    .parchment {
      width: 100%;
      box-sizing: border-box;
    }
    .parchment-inner {
      padding: 40px 20px;
      box-sizing: border-box;
      width: 100%;
    }
    .parchment-long .parchment-inner {
      padding: 48px 20px 56px;
      box-sizing: border-box;
      width: 100%;
    }
  }

  /* Shared SVG crinkles block — used inside every parchment */
  .crinkles-defs { position: absolute; width: 0; height: 0; overflow: hidden; }

  /* ═══════════════════════════════════════════════════════════════════
     REFRESH-2026-04-29 ADDITIONS
     ═══════════════════════════════════════════════════════════════════
     Layered ON TOP of the existing parchment system. Nothing above is
     modified. The parchment aesthetic is the page's defining register
     and stays untouched. These additions contribute four things:
       1. A ceremonial signature line (Pinyon Script cursive)
       2. Brass shimmer nods on small labels (tier kickers, path icons,
          committed celebration title) — sparing, not dismantling
       3. Asterism marks between major parchment sections
       4. A mid-mobile (720px) layer to handle tier rows, commit area,
          and quiz cards that the existing 768px / 480px queries skip
     ═══════════════════════════════════════════════════════════════════ */

  /* ── Card-brass token (cream context) and asterism mark ──────────── */
  :root {
    --pact-card-brass: linear-gradient(95deg,
      #7a4a10 0%, #b8862e 20%, #d4a84a 38%, #ecb438 50%,
      #d4a84a 62%, #b8862e 80%, #7a4a10 100%);
    --pact-card-brass-shadow: drop-shadow(0 2px 0 rgba(28, 24, 20, 0.20));
  }

  /* ── Brass shimmer on small labels (sparing) ─────────────────────── */
  .tier-row-kicker {
    background: var(--pact-card-brass);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    background-clip: text;
    filter: var(--pact-card-brass-shadow);
    color: transparent !important;
  }
  .committed-title em {
    background: var(--pact-card-brass);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    background-clip: text;
    filter: var(--pact-card-brass-shadow);
    color: transparent !important;
  }

  /* ── Asterism mark — appears at the end of each parchment section's
        inner content. Uses ::after so the existing markup is unchanged.
        Only renders for the main long-form parchment sections (the
        ones with .parchment-long), not the hero or commit panels. ── */
  .parchment-long .parchment-inner::after {
    content: "✦   ✦   ✦";
    display: block;
    text-align: center;
    font-family: var(--font-display);
    font-size: clamp(1rem, 1vw + 0.7rem, 1.4rem);
    color: var(--gold);
    letter-spacing: 0.4em;
    margin-top: clamp(28px, 3vw, 48px);
    opacity: 0.5;
  }

  /* ── Signature line: Pinyon Script cursive above the commit button ─
        A formal-document signature line. Replaces nothing; sits above
        the existing "I Understand — Enter" button. The user types
        their name in flourishing 19th-century formal cursive (Pinyon
        Script, Google Fonts), which provides the ceremonial weight a
        commitment of this nature deserves. The button is gated on the
        signature having content (handled in JS). ───────────────────── */
  .signature-area {
    margin: 36px auto 28px;
    /* Widened from 420px on 2026-05-01 — several script fonts (Hurricane,
       Cherish, Oooh Baby) render visibly wider than Mrs Saint Delafield
       at the same nominal size, so an 80-char name was getting clipped
       on the original line length. 720px clears all 9 fonts at sensible
       names. The input's max-width is still bounded by the parent form. */
    max-width: 720px;
    text-align: center;
  }
  .signature-prompt {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--terra);
    margin-bottom: 22px;
    display: block;
  }
  .signature-line {
    position: relative;
    border-bottom: 1px solid rgba(140, 74, 47, 0.55);
    /* Top padding bumped 4 → 12 so the cursive ascenders (capital D
       and P flourishes etc.) have a clear margin above the underline
       instead of clipping against the prompt above. */
    padding: 12px 16px 6px;
    margin-bottom: 8px;
  }
  .signature-line::before {
    /* Old-fashioned signature-line "X" marker on the left */
    content: "✕";
    position: absolute;
    left: 0; bottom: 6px;
    color: rgba(140, 74, 47, 0.6);
    font-family: var(--font-mono);
    font-size: 12px;
  }
  .signature-input {
    width: 100%;
    background: transparent;
    border: none;
    outline: none;
    /* Mrs Saint Delafield is the default; the JS picker swaps the family
       inline when the user clicks a chip. The per-font scale variable
       (--sig-scale) is also set inline so each face renders at a
       similar visual height — see the data-font rules on the chips
       below for the canonical scale values. Default 1.0 = baseline.
       line-height: 1.5 (was 1.05) gives the script-font ascenders
       room — without it, capital flourishes on D, P, etc. clip
       against the top of the input box. */
    font-family: 'Mrs Saint Delafield', 'Allura', 'Cormorant Garamond', cursive;
    font-size: calc(clamp(2.0rem, 4vw + 0.6rem, 3.0rem) * var(--sig-scale, 1));
    color: var(--ox);
    text-align: center;
    padding: 0 16px;
    line-height: 1.5;
    letter-spacing: 0.01em;
  }
  .signature-input::placeholder {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1rem;
    color: rgba(140, 74, 47, 0.35);
    letter-spacing: 0.02em;
  }
  /* ── Signature font picker ────────────────────────────────────────────
        A row of chips below the signature line, each rendered in its own
        Google Font. Clicking re-renders the signature input live. The
        chosen font persists with the Pact commit (signature_font column
        on profiles) and surfaces as the contributor's signature on
        their profile page and at the bottom of articles they author.
        Keep the family list in sync with api/_signature-fonts.js.
        ───────────────────────────────────────────────────────────── */
  .signature-font-picker {
    margin: 22px auto 0;
    max-width: 520px;
    text-align: center;
  }
  .signature-font-picker-label {
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--brass-warm, #b8862e);
    display: block;
    margin-bottom: 12px;
    font-style: italic;
  }
  .signature-font-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
  }
  .signature-font-chip {
    font-size: 1.15rem;
    line-height: 1;
    padding: 8px 14px;
    border: 1px solid rgba(140, 74, 47, 0.22);
    border-radius: 4px;
    background: rgba(255, 253, 248, 0.55);
    color: rgba(60, 44, 28, 0.78);
    cursor: pointer;
    transition: border-color 0.18s ease, background-color 0.18s ease, transform 0.18s ease;
    user-select: none;
  }
  .signature-font-chip:hover {
    border-color: rgba(184, 134, 46, 0.55);
    background: rgba(255, 253, 248, 0.95);
  }
  .signature-font-chip.is-active {
    border-color: var(--gold-bright, #d4a84a);
    background: rgba(245, 223, 160, 0.22);
    color: var(--brass-deep, #6a4a18);
    box-shadow: 0 1px 0 rgba(184, 134, 46, 0.30);
  }
  /* Per-font family. Each chip's --sig-scale (and the .signature-font-chip
     base font-size) is set by the picker JS at page load using actual
     canvas measurements of each font's rendered bounding box, so all 9
     faces visually equalize regardless of intrinsic x-height. The static
     scale multipliers here used to be eyeballed; the canvas-measure
     approach replaces that with real numbers. */
  .signature-font-chip {
    /* Multiplied by --sig-scale set per-chip by the picker JS. Default
       1.0 keeps the chip readable before measurement completes. */
    font-size: calc(1.2rem * var(--sig-scale, 1));
  }
  .signature-font-chip[data-font="Mrs Saint Delafield"]  { font-family: 'Mrs Saint Delafield', cursive; }
  .signature-font-chip[data-font="Cherish"]              { font-family: 'Cherish', cursive; }
  .signature-font-chip[data-font="Give You Glory"]       { font-family: 'Give You Glory', cursive; }
  .signature-font-chip[data-font="Hurricane"]            { font-family: 'Hurricane', cursive; }
  .signature-font-chip[data-font="Love Light"]           { font-family: 'Love Light', cursive; }
  .signature-font-chip[data-font="Nothing You Could Do"] { font-family: 'Nothing You Could Do', cursive; }
  .signature-font-chip[data-font="Oooh Baby"]            { font-family: 'Oooh Baby', cursive; }
  .signature-font-chip[data-font="Qwigley"]              { font-family: 'Qwigley', cursive; }
  .signature-font-chip[data-font="WindSong"]             { font-family: 'WindSong', cursive; }
  /* Hide the picker once the signature is sealed — the choice is locked. */
  .commit-form.committed-sealed .signature-font-picker { display: none; }
  .signature-name-label {
    display: block;
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--tertiary);
  }

  /* ── Mid-mobile augmentation (720px) — fills the gap between the
        existing 768px and 480px queries, focused on surfaces those
        queries don't cover. ───────────────────────────────────────── */
  @media (max-width: 720px) {
    /* Tier rows: stack icon above text on narrow widths so neither
       gets crushed. The grid-template stays for desktop. */
    .tier-row {
      grid-template-columns: 1fr;
      gap: 14px;
      padding: 22px 0;
    }
    .tier-row-icon { padding-top: 0; }
    .tier-row-name { font-size: clamp(1.7rem, 6vw, 2.4rem); margin-bottom: 12px; }
    .tier-row-desc { font-size: 0.96rem; line-height: 1.65; }
    .tier-row-desc::first-letter { font-size: 2.6rem; }

    /* Quiz card breathing room */
    .quiz-card { padding: 22px 18px; }

    /* Commit form internal spacing */
    .commit-form { padding-top: 8px; }
    .pact-text { font-size: 1rem; line-height: 1.7; }
    .signature-input { padding: 0 12px; }
  }
</style>

<div class="page">
<div class="pact-stage">

<!-- ═══ HERO ═══ -->
<section class="parchment fade-in">
