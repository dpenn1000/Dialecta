<div class="section-mark"><span class="section-mark-num">§ VIII · The Commitment</span></div>
<div style="text-align: center;"><span class="eyebrow">The commitment</span>
    <h2 class="display" style="margin-left: auto; margin-right: auto;">I understand and want<br>to <em>participate.</em></h2>

    {{#if @member}}
    <div class="commit-form" id="commitForm" data-member-uuid="{{@member.uuid}}">
      <p class="pact-text">
        I am here to engage with ideas, not to signal my team. I understand that my
        words carry weight and that the platform will hold them accountable, not to
        punish me, but to take me seriously. I welcome the mirror. I am willing to
        be surprised by what I find in my own thinking.
      </p>
      {{!-- Signature line: the user types their name in flourishing
            cursive (Pinyon Script). Acts as the ritual touchpoint
            before the commit button — a real-document gesture, not
            just a click. The button stays disabled until the
            signature has at least 2 characters of content. --}}
      <div class="signature-area">
        <span class="signature-prompt">Sign your name below</span>
        <div class="signature-line">
          <input
            type="text"
            id="signatureInput"
            class="signature-input"
            autocomplete="off"
            spellcheck="false"
            maxlength="80"
            aria-label="Your signature"
            placeholder="Your full name"
          >
        </div>
        <span class="signature-name-label">Signed in your hand</span>

        {{!-- Font picker. The chip whose data-font matches the
              active font carries .is-active. JS toggles the class
              and updates the signature input's font-family live.
              The chosen font is sent with the Pact commit. --}}
        <div class="signature-font-picker">
          <span class="signature-font-picker-label">Pick your hand</span>
          <div class="signature-font-chips" id="signatureFontChips">
            <button type="button" class="signature-font-chip is-active" data-font="Mrs Saint Delafield">Aa</button>
            <button type="button" class="signature-font-chip"           data-font="Cherish">Aa</button>
            <button type="button" class="signature-font-chip"           data-font="Give You Glory">Aa</button>
            <button type="button" class="signature-font-chip"           data-font="Hurricane">Aa</button>
            <button type="button" class="signature-font-chip"           data-font="Love Light">Aa</button>
            <button type="button" class="signature-font-chip"           data-font="Nothing You Could Do">Aa</button>
            <button type="button" class="signature-font-chip"           data-font="Oooh Baby">Aa</button>
            <button type="button" class="signature-font-chip"           data-font="Qwigley">Aa</button>
            <button type="button" class="signature-font-chip"           data-font="WindSong">Aa</button>
          </div>
        </div>
      </div>

      <p id="commitError" style="display:none; color:#b8372e; font-family: var(--font-body); font-size: 0.9rem; text-align:center; margin: 0 0 16px;"></p>
      <div class="commit-wrap">
        <button class="brass" id="commitBtn" onclick="commit()" disabled>I Understand &middot; Enter</button>
      </div>
    </div>
    {{else}}
    <div class="commit-form" style="text-align:center;">
      <p class="pact-text" style="margin-bottom: 24px;">
        I am here to engage with ideas, not to signal my team. I understand that my
        words carry weight and that the platform will hold them accountable, not to
        punish me, but to take me seriously. I welcome the mirror. I am willing to
        be surprised by what I find in my own thinking.
      </p>
      <p style="font-family: var(--font-reading); font-size: 0.95rem; color: var(--secondary); font-style: italic; margin-bottom: 20px; line-height: 1.6;">
        The Pact is a commitment, not a checkbox. Sign in to take it.
      </p>
      <div class="commit-wrap">
        <a href="#/portal/signin" data-portal="signin" class="brass" style="text-decoration:none; display:inline-block;">Sign in to commit</a>
      </div>
      <p style="font-family: var(--font-reading); font-size: 0.85rem; color: var(--tertiary); font-style: italic; margin-top: 16px;">
        Don't have an account yet?
        <a href="#/portal/signup" data-portal="signup" style="color: var(--amber); text-decoration: none;">Join Dialecta</a>.
      </p>
    </div>
    {{/if}}

    <div class="committed" id="committedState">
      <div class="committed-mark">✦</div>
      <div class="committed-title">Welcome to <em>Dialecta.</em></div>
      <div class="committed-sub">Your words are yours here. Use them well, and let the platform show you how to use them better.</div>
      <button class="brass">Enter the Forum →</button>
    </div></div>
  </div>
  <div class="folio">§ II–VIII</div>
</section>

</div><!-- /stage -->

<footer class="footer">
  <div class="footer-mark">Dialecta</div>
  <p class="footer-note">A platform for constructive dialogue, informed debate, and idea-first discourse. Founded April 2026. Built on the belief that thinking well is worth rewarding.</p>
</footer>

</div><!-- /page -->

<script>
  const answers = { 1: 'heat', 2: 'forum', 3: 'fog' };
  const feedback = {
    1: {
      correct: "<strong>The Heat, correct.</strong> There&rsquo;s a factual claim buried here (doesn&rsquo;t work at scale) but it arrives without evidence, wrapped in dismissal. The feeling is leading the argument, not the argument itself. A Forum version of this comment would cite the specific numbers it claims exist.",
      wrong:   "<strong>The Heat is the closest read.</strong> There&rsquo;s a factual claim in here, scale limitations, but it&rsquo;s never substantiated. Wake up signals frustration rather than evidence. The Stance would require more explicit tribal framing; The Forum would require the actual numbers it gestures at."
    },
    2: {
      correct: "<strong>The Forum, correct.</strong> This comment names a specific gap in the argument (transition costs), acknowledges what the article did well, and asks a precise question. Disagreement with a cited reason and a genuine question, that&rsquo;s exactly what The Forum rewards.",
      wrong:   "<strong>The Forum is the right call here.</strong> Notice the structure: it names what worked, identifies a specific gap, and asks a genuine question rather than making an assertion. That combination is what separates Forum from everything below it."
    },
    3: {
      correct: "<strong>The Fog, correct.</strong> The commenter has a feeling but hasn&rsquo;t located an idea yet. Something resonates and there&rsquo;s probably more to it, neither sentence tells us what they actually think. Not harmful, not dismissive, just genuinely unclear. An invitation to say more.",
      wrong:   "<strong>The Fog is the right tier here.</strong> This isn&rsquo;t The Spark, there&rsquo;s no seed of an idea, just a vague sense of one. It isn&rsquo;t Echo because it doesn&rsquo;t restate anything. It&rsquo;s Fog: the reader genuinely can&rsquo;t tell what position the commenter holds."
    }
  };
  let score = 0;

  function answer(q, choice, btn) {
    const btns = btn.parentElement.querySelectorAll('.quiz-btn');
    btns.forEach(b => b.disabled = true);
    const correct = answers[q];
    const isCorrect = choice === correct;
    if (isCorrect) score++;
    btn.classList.add(isCorrect ? 'correct' : 'incorrect');
    btns.forEach(b => {
      if (b !== btn && b.getAttribute('onclick').includes("'" + correct + "'")) {
        b.classList.add('revealed');
      }
    });
    const fb = document.getElementById('f' + q);
    fb.innerHTML = isCorrect ? feedback[q].correct : feedback[q].wrong;
    fb.classList.add('visible');
    document.getElementById('n' + q).classList.add('visible');
  }
  function nextQ(n) {
    document.getElementById('q' + (n-1)).classList.remove('active');
    document.getElementById('q' + n).classList.add('active');
    document.getElementById('q' + n).scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
  function showResult() {
    document.getElementById('q3').classList.remove('active');
    const result = document.getElementById('qresult');
    result.classList.add('visible');
    document.getElementById('score-display').textContent = score + '/3';
    const msgs = {
      0: "You’re exactly who this platform is for. The tier system takes time to internalize. That’s intentional. Every reflection is a chance to sharpen the eye.",
      1: "A solid start. One of these distinctions is genuinely subtle. Most people miss it the first time. That’s the system working as designed.",
      2: "Strong reading. You’re already thinking the way this platform rewards. The third distinction is the hardest one in practice.",
      3: "You have the eye. Welcome. The community will benefit from how you see."
    };
    document.getElementById('score-msg').textContent = msgs[score];
  }
  // The commit button enables as soon as the signature has at least 2
  // characters. The earlier requirement to pick Path A / Path B was
  // removed 2026-04-29 — that choice now lives in the post composer
  // where it actually applies, not in the sign-on ritual.
  function refreshCommitGate() {
    var sig = document.getElementById('signatureInput');
    var btn = document.getElementById('commitBtn');
    if (!btn) return;
    var hasName = !!sig && sig.value.trim().length >= 2;
    btn.disabled = !hasName;
    // Mirror what the user is typing into every chip so the preview
    // shows their actual signature in each font, not just "Aa". Falls
    // back to "Aa" while the input is empty.
    var preview = (sig && sig.value.trim()) ? sig.value : 'Aa';
    var chips = document.querySelectorAll('.signature-font-chip');
    for (var i = 0; i < chips.length; i++) chips[i].textContent = preview;
  }
  // Wire the signature input to refresh the gate on every keystroke.
  // Defer to next tick so the input element is mounted before we
  // attach. addEventListener with a stale ref crashes silently if the
  // form is gated to non-members (then the signature input doesn't
  // render at all), hence the null-guard.
  (function () {
    var attach = function () {
      var sig = document.getElementById('signatureInput');
      if (sig) sig.addEventListener('input', refreshCommitGate);
      attachSignatureFontPicker();
      // Kick off canvas-based font calibration. Async; updates the
      // chip scales + signature input in place once measurements
      // come back. Fonts may finish loading in any order, so we wait
      // on document.fonts.load promises before measuring.
      calibrateSignatureFonts().catch(function () { /* swallow */ });
    };
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', attach);
    } else {
      attach();
    }
  })();
  // Default font matches the .signature-input CSS (Mrs Saint Delafield)
  // so the page renders identically before any chip is clicked. The JS
  // mutation later overwrites this when the user picks a chip.
  var SELECTED_SIGNATURE_FONT = 'Mrs Saint Delafield';
  // Per-font scale, computed at page load by measuring each font's
  // actual rendered bounding box on a canvas (see calibrateSignatureFonts
  // below). Pre-seeded with 1.0 so the page renders sanely before
  // calibration completes. Mrs Saint Delafield is the baseline (always 1.0).
  var SIGNATURE_FONT_SCALES = {
    'Mrs Saint Delafield':  1.00,
    'Cherish':              1.00,
    'Give You Glory':       1.00,
    'Hurricane':            1.00,
    'Love Light':           1.00,
    'Nothing You Could Do': 1.00,
    'Oooh Baby':            1.00,
    'Qwigley':              1.00,
    'WindSong':             1.00
  };
  // List of all 9 fonts the picker offers — used by the calibrator to
  // know which families to load and measure.
  var SIGNATURE_FONT_LIST = Object.keys(SIGNATURE_FONT_SCALES);
  var SIGNATURE_BASELINE_FONT = 'Mrs Saint Delafield';

  /* ── Dynamic font calibration ──
     Each cursive face has a wildly different intrinsic visual height
     at the same em-size: Qwigley's caps + flourishes barely reach the
     x-height of Cherish's; Oooh Baby's swirls overshoot most others.
     Static scale guesses can't normalize all 9 — so we measure each
     font's actual rendered bounding box on a canvas and compute the
     scale needed to bring it to the baseline (Mrs Saint Delafield).
     Result: every font renders at the same visible height across the
     picker chips and the signature input.
     Sample text uses both ascenders and descenders ('Pgy Hk') so the
     measurement captures the full vertical extent each font occupies. */
  var SIGNATURE_CALIBRATION_SAMPLE = 'Pgy Hk';
  var SIGNATURE_CALIBRATION_BASE_PX = 100;

  function measureFontHeight(family, text) {
    if (!measureFontHeight._ctx) {
      var canvas = document.createElement('canvas');
      measureFontHeight._ctx = canvas.getContext('2d');
    }
    var ctx = measureFontHeight._ctx;
    ctx.font = SIGNATURE_CALIBRATION_BASE_PX + 'px "' + family + '", cursive';
    var m = ctx.measureText(text);
    var ascent  = m.actualBoundingBoxAscent  || 0;
    var descent = m.actualBoundingBoxDescent || 0;
    return ascent + descent;
  }

  async function calibrateSignatureFonts() {
    // Wait for all 9 signature fonts to load before measuring. Without
    // this, the canvas falls back to a system font and the heights are
    // identical (and useless).
    if (document.fonts && document.fonts.load) {
      try {
        await Promise.all(SIGNATURE_FONT_LIST.map(function (f) {
          return document.fonts.load(SIGNATURE_CALIBRATION_BASE_PX + 'px "' + f + '"');
        }));
      } catch (e) { /* ignore — partial load still gives useful data */ }
    }

    var baseHeight = measureFontHeight(SIGNATURE_BASELINE_FONT, SIGNATURE_CALIBRATION_SAMPLE);
    if (!baseHeight || !isFinite(baseHeight)) return; // measurement failed; keep 1.0 fallbacks

    for (var i = 0; i < SIGNATURE_FONT_LIST.length; i++) {
      var f = SIGNATURE_FONT_LIST[i];
      var h = measureFontHeight(f, SIGNATURE_CALIBRATION_SAMPLE);
      if (h > 0 && isFinite(h)) {
        SIGNATURE_FONT_SCALES[f] = baseHeight / h;
      }
    }

    // Apply to chips (sets --sig-scale per chip).
    var chips = document.querySelectorAll('.signature-font-chip');
    for (var j = 0; j < chips.length; j++) {
      var chip = chips[j];
      var fam  = chip.getAttribute('data-font');
      if (fam && SIGNATURE_FONT_SCALES[fam] != null) {
        chip.style.setProperty('--sig-scale', SIGNATURE_FONT_SCALES[fam]);
      }
    }

    // Re-apply current font to the signature input so its scale picks
    // up the freshly-measured value.
    applySignatureFont(SELECTED_SIGNATURE_FONT);
  }
  function applySignatureFont(fontName) {
    SELECTED_SIGNATURE_FONT = fontName;
    var sig = document.getElementById('signatureInput');
    if (sig) {
      // Quote the family because every option is a multi-word name.
      sig.style.fontFamily = '"' + fontName + '", cursive';
      // Apply the per-font scale so e.g. Qwigley renders larger than
      // its intrinsic 1em (which would otherwise read as too small
      // next to Mrs Saint Delafield).
      var scale = SIGNATURE_FONT_SCALES[fontName] || 1;
      sig.style.setProperty('--sig-scale', scale);
    }
    var chips = document.querySelectorAll('.signature-font-chip');
    for (var i = 0; i < chips.length; i++) {
      var c = chips[i];
      if (c.getAttribute('data-font') === fontName) c.classList.add('is-active');
      else c.classList.remove('is-active');
    }
  }
  function attachSignatureFontPicker() {
    var chips = document.querySelectorAll('.signature-font-chip');
    for (var i = 0; i < chips.length; i++) {
      (function (chip) {
        chip.addEventListener('click', function (e) {
          // Defensive — the buttons are type="button" but stop default
          // anyway so a parent <form> never gets a stray submit.
          e.preventDefault();
          var font = chip.getAttribute('data-font');
          if (font) applySignatureFont(font);
        });
      })(chips[i]);
    }
  }
  // Pact-text version. Bump when the body of the Pact changes
  // materially. Stored on the profile row so we can re-prompt members
  // who agreed to an older version.
  var PACT_VERSION = '1.0';

  async function commit() {
    var btn   = document.getElementById('commitBtn');
    var form  = document.getElementById('commitForm');
    var errEl = document.getElementById('commitError');
    var sig   = document.getElementById('signatureInput');
    var memberUuid = form && form.getAttribute('data-member-uuid');
    var signedName = sig ? sig.value.trim() : '';

    if (!memberUuid) {
      // Defensive — the @member branch should not even render the form
      // for non-members, but guard anyway.
      window.location.href = '#/portal/signin';
      return;
    }
    if (signedName.length < 2) {
      if (errEl) { errEl.style.display = 'block'; errEl.textContent = 'Please sign your name above.'; }
      if (sig) sig.focus();
      return;
    }

    var apiBase = (window.__DIALECTA_API_URL__ || '').replace(/\/$/, '');
    var origText = btn.textContent;
    btn.disabled = true;
    btn.textContent = 'Committing…';
    if (errEl) errEl.style.display = 'none';

    try {
      var res = await fetch(apiBase + '/api/profile/' + encodeURIComponent(memberUuid), {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify({
          _action:        'become_author',
          pact_version:   PACT_VERSION,
          signed_name:    signedName,
          signature_font: SELECTED_SIGNATURE_FONT,
        }),
      });
      var json = await res.json().catch(function () { return {}; });
      if (!res.ok && !(res.status === 409 && json.already_author)) {
        throw new Error(json.error || ('Commit failed: ' + res.status));
      }
      // Success path (200) and idempotent re-commit (409 already_author)
      // both transform the form into its sealed state. The signature
      // stays on the page as the permanent record — "hardened" the same
      // way a posted comment hardens after its malleability window. The
      // brass button is replaced with a "Begin →" link to /profile/, so
      // there is no longer a clickable button waiting for resubmission.
      form.classList.add('committed-sealed');
      if (sig) { sig.readOnly = true; sig.setAttribute('aria-readonly', 'true'); }
      btn.disabled = true;
      var promptEl = form.querySelector('.signature-prompt');
      if (promptEl) promptEl.textContent = '✦  Sealed';
      var nameLabelEl = form.querySelector('.signature-name-label');
      if (nameLabelEl) {
        var when = new Date().toLocaleDateString(undefined, { year: 'numeric', month: 'long', day: 'numeric' });
        nameLabelEl.textContent = 'Committed · ' + when;
      }
      var btnWrap = btn.parentElement;
      if (btnWrap) {
        btnWrap.innerHTML = '<a class="brass committed-cta" href="/profile/">Welcome to Dialecta &middot; Begin →</a>';
      }
      // The legacy committedState block below is no longer needed — the
      // sealed form is the celebration. Scroll the form's footer into
      // view so the new "Begin" link sits clearly in the viewport.
      if (btnWrap && typeof btnWrap.scrollIntoView === 'function') {
        btnWrap.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
    } catch (err) {
      btn.disabled = false;
      btn.textContent = origText;
      if (errEl) {
        errEl.style.display = 'block';
        errEl.textContent = err.message || 'Could not commit. Try again in a moment.';
      }
    }
  }


</script>

{{/post}}
